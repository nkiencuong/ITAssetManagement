@page "/audit-logs"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Nhật ký Hệ thống</PageTitle>

<div class="container-fluid mt-4">
    @* --- HEADER & TOOLBAR --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-0"><i class="bi bi-shield-lock-fill me-2"></i>Nhật Ký Hệ Thống</h3>
            <small class="text-muted">Theo dõi mọi hoạt động và thay đổi trong phần mềm</small>
        </div>
        <button class="btn btn-outline-primary shadow-sm" @onclick="LoadLogs" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span> <span>Đang tải...</span>
            }
            else
            {
                <span><i class="bi bi-arrow-clockwise"></i> Làm mới</span>
            }
        </button>
    </div>

    @* --- THANH TÌM KIẾM --- *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" 
                       placeholder="Tìm kiếm theo tên người dùng, hành động, hoặc chi tiết..." 
                       @bind="searchText" @bind:event="oninput" />
            </div>
        </div>
    </div>

    @* --- BẢNG DỮ LIỆU --- *@
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4 py-3">Thời gian</th>
                        <th>Người thực hiện</th>
                        <th>Phòng ban</th> @* 👈 CỘT MỚI *@
                        <th>Hành động</th>
                        <th>Đối tượng</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5"> @* colspan=6 vì thêm 1 cột *@
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-muted">Đang đồng bộ dữ liệu...</p>
                            </td>
                        </tr>
                    }
                    else if (!PagedLogs.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy nhật ký nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in PagedLogs)
                        {
                            <tr>
                                <td class="ps-4 text-nowrap text-muted small">@log.ActionDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="fw-bold text-dark">@log.UserName</td>
                                
                                @* 👇 CỘT PHÒNG BAN *@
                                <td>
                                    @if (!string.IsNullOrEmpty(log.DepartmentName) && log.DepartmentName != "Chưa xác định")
                                    {
                                        <span class="badge bg-light text-secondary border">@log.DepartmentName</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @GetBadgeClass(log.Action) px-2 py-1">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@log.TableName</span></td>
                                <td class="text-secondary small">@log.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        @* --- FOOTER PHÂN TRANG --- *@
        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Hiển thị @PagedLogs.Count() / @FilteredLogs.Count() dòng</span>
            
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Trước</button>
                    </li>
                    <li class="page-item disabled"><span class="page-link">Trang @currentPage / @TotalPages</span></li>
                    <li class="page-item @(currentPage >= TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Sau</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@code {
    private List<AuditLogResponse> allLogs = new();
    private bool isLoading = true;
    private string searchText = "";
    
    // Cấu hình phân trang
    private int currentPage = 1;
    private int pageSize = 15; // Số dòng mỗi trang

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        isLoading = true;
        try
        {
            // Gọi API
            var result = await Http.GetFromJsonAsync<List<AuditLogResponse>>("api/admin/auditlog");
            if (result != null)
            {
                allLogs = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // Logic Lọc dữ liệu (Search)
    private IEnumerable<AuditLogResponse> FilteredLogs => 
        allLogs.Where(x => string.IsNullOrEmpty(searchText) || 
                           x.UserName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                           x.Action.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                           x.Details.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                           x.DepartmentName.Contains(searchText, StringComparison.OrdinalIgnoreCase)); // 👈 Thêm tìm kiếm theo Phòng

    // Logic Phân trang
    private IEnumerable<AuditLogResponse> PagedLogs => 
        FilteredLogs.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private int TotalPages => (int)Math.Ceiling((double)FilteredLogs.Count() / pageSize);

    private void ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages) return;
        currentPage = newPage;
    }

    // Logic Màu sắc Badge
    private string GetBadgeClass(string action)
    {
        action = action.ToLower();
        if (action.Contains("xóa") || action.Contains("hủy") || action.Contains("báo hỏng")) return "bg-danger"; // Đỏ
        if (action.Contains("sửa") || action.Contains("cập nhật") || action.Contains("thu hồi")) return "bg-warning text-dark"; // Vàng
        if (action.Contains("thêm") || action.Contains("tạo") || action.Contains("cấp phát") || action.Contains("sửa xong")) return "bg-success"; // Xanh lá
        return "bg-info text-dark"; // Xanh dương (Mặc định)
    }

    public class AuditLogResponse
    {
        public int LogID { get; set; }
        public string Action { get; set; } = string.Empty;
        public string TableName { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty; // 👈 ĐÃ THÊM CỘT NÀY
        public DateTime ActionDate { get; set; }
        public string Details { get; set; } = string.Empty;
    }
}