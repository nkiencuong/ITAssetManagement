@page "/history"
@using ITAssetManagement.Client.Pages
@inject HttpClient Http

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary">📜 Lịch sử Nhập/Xuất Kho</h3>

        <div class="d-flex gap-2 bg-white p-2 rounded shadow-sm">
            <div class="d-flex align-items-center">
                <label class="me-2 fw-bold small">Từ:</label>
                <input type="date" class="form-control form-control-sm" @bind="fromDate" />
            </div>
            <div class="d-flex align-items-center">
                <label class="me-2 fw-bold small">Đến:</label>
                <input type="date" class="form-control form-control-sm" @bind="toDate" />
            </div>
            @* 🚀 1. MỚI THÊM: DROPDOWN LỌC LOẠI GIAO DỊCH *@
            <div class="d-flex align-items-center border-start ps-2 ms-1">
                <label class="me-2 fw-bold small text-primary">Loại GD:</label>
                <select class="form-select form-select-sm border-primary fw-bold" style="width: 140px;" value="@selectedType" @onchange="OnTypeChanged">
                    <option value="">-- Tất cả --</option>
                    <option value="IN">Chỉ xem Nhập</option>
                    <option value="OUT">Chỉ xem Xuất</option>
                    <option value="REPAIR">Sửa chữa</option>
                </select>
            </div>
            @* 🚀 THÊM Ô TÌM KIẾM Ở ĐÂY *@
            <input type="text" class="form-control form-control-sm"
                   placeholder="Tìm tên thiết bị, phòng ban, mã phiếu..."
                   style="width: 280px;"
                   @bind="keyword"
                   @bind:event="oninput"
                   @onkeyup="ApplyFilter" />

            <button class="btn btn-primary btn-sm" @onclick="LoadData">
                🔍 Tải lại
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Đang tải dữ liệu...</p>
        </div>
    }
    else if (historyList == null || historyList.Count == 0)
    {
        <div class="alert alert-warning text-center">
            Không tìm thấy dữ liệu lịch sử nào trong khoảng thời gian này.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>Thời gian</th>
                            <th>Mã phiếu</th>
                            <th>Tài sản</th>
                            <th>Loại GD</th>
                            <th>SL</th>
                            <th>Phòng ban</th>
                            <th>Người thực hiện</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 👇 DUYỆT QUA pagedHistory THAY VÌ historyList *@
                        @foreach (var item in pagedHistory)
                        {
                            <tr>
                                <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-secondary">@item.ReferenceNo</span></td>
                                <td class="fw-bold text-primary">@item.AssetName</td>
                                <td>
                                    @if (item.Type == "IN" || item.Type == "Nhập kho")
                                    {
                                        <span class="badge bg-success">Nhập kho</span>
                                    }
                                    else if (item.Type == "OUT" || item.Type == "Xuất kho")
                                    {
                                        <span class="badge bg-danger">Xuất kho</span>
                                    }
                                    else if (item.Type == "OUT_REPAIR" || item.Type == "REPAIR" || item.Type == "Sửa chữa")
                                    {
                                        <span class="badge bg-info text-dark">Sửa chữa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Type</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.Quantity</td>
                                <td>@item.DepartmentName</td>
                                <td>@item.UserName</td>
                                <td class="text-muted small">@item.Note</td>
                            </tr>
                        }
                    </tbody>
                    @* 🚀 MỚI THÊM: DÒNG TỔNG SỐ LƯỢNG *@
                    @* <tfoot class="table-light fw-bold border-top border-2">
                        <tr>
                            <td colspan="4" class="text-end py-3 text-primary text-uppercase">TỔNG SỐ LƯỢNG TRÊN LƯỚI:</td>
                            <td class="text-danger fs-5 py-3">@filteredList.Sum(x => x.Quantity)</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot> *@
                </table>
            </div>

            @* 👇 THANH PHÂN TRANG 👇 *@
            <div class="card-footer bg-white border-0 py-3">
                <Pagination CurrentPage="@currentPage"
                            TotalItems="@filteredList.Count"
                            PageSize="@pageSize"
                            OnPageChanged="ChangePage" />
            </div>
        </div>
    }
</div>

@code {
    private List<WarehouseHistoryResponse> historyList = new();
    //  TÌM KIẾM
    private List<WarehouseHistoryResponse> filteredList = new();
    private string keyword = "";
    //  THÊM 2 CÁI NÀY ĐỂ HỨNG SỰ KIỆN TỪ DROPDOWN
    private string selectedType = "";
    private void OnTypeChanged(ChangeEventArgs e)
    {
        selectedType = e.Value?.ToString() ?? "";
        ApplyFilter(); // GỌi hàm lọc ngay khi chọn
    }
    // 👇 PHÂN TRANG
    private List<WarehouseHistoryResponse> pagedHistory = new();
    private int currentPage = 1;
    private int pageSize = 15;

    private bool isLoading = true;
    private DateTime? fromDate = DateTime.Today.AddDays(-30);
    private DateTime? toDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            string queryUrl = "api/warehouse/history";
            var queryParams = new List<string>();

            if (fromDate.HasValue) queryParams.Add($"fromDate={fromDate.Value:yyyy-MM-dd}");
            if (toDate.HasValue) queryParams.Add($"toDate={toDate.Value:yyyy-MM-dd}");
            if (queryParams.Count > 0) queryUrl += "?" + string.Join("&", queryParams);

            // Tải danh sách gốc từ API
            historyList = await Http.GetFromJsonAsync<List<WarehouseHistoryResponse>>(queryUrl) ?? new List<WarehouseHistoryResponse>();

            // 👇 GỌI HÀM LỌC SAU KHI TẢI XONG
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi tải lịch sử: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
    // ĐỂ XỬ LÝ TÌM KIẾM
    private void ApplyFilter()
    {
        if (historyList == null) return;

        var query = historyList.AsEnumerable();

        // Lọc theo Dropdown (Nhập / Xuất)
        if (!string.IsNullOrEmpty(selectedType))
        {
            if (selectedType == "IN")
                query = query.Where(x => x.Type == "IN" || x.Type == "Nhập kho");
            else if (selectedType == "OUT")
                query = query.Where(x => x.Type == "OUT" || x.Type == "Xuất kho" || x.Type == "Cấp phát");
            else if (selectedType == "REPAIR")
                query = query.Where(x => x.Type == "OUT_REPAIR" || x.Type == "REPAIR" || x.Type == "Sửa chữa");
        }

        // Lọc theo Chữ nhập vào
        if (!string.IsNullOrWhiteSpace(keyword))
        {
            var kw = keyword.ToLower();
            query = query.Where(x =>
                (x.AssetName != null && x.AssetName.ToLower().Contains(kw)) ||
                (x.DepartmentName != null && x.DepartmentName.ToLower().Contains(kw)) ||
                (x.ReferenceNo != null && x.ReferenceNo.ToLower().Contains(kw))
            );
        }

        // Gán lại danh sách đã lọc
        filteredList = query.ToList();

        // Sau khi lọc xong, đưa trang về 1 và cắt dữ liệu
        currentPage = 1;
        UpdatePagedList();
    }

    // 👇 LOGIC PHÂN TRANG
    private void UpdatePagedList()
    {
        if (filteredList != null)
        {
            pagedHistory = filteredList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        }
    }

    private void ChangePage(int page)
    {
        currentPage = page;
        UpdatePagedList();
    }

    public class WarehouseHistoryResponse
    {
        public int TransactionID { get; set; }
        public string AssetName { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public DateTime Date { get; set; }
        public string DepartmentName { get; set; } = "N/A";
        public string UserName { get; set; } = "N/A";
        public string Note { get; set; } = string.Empty;
        public string ReferenceNo { get; set; } = string.Empty;
    }
}