@page "/repairs"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavManager
@attribute [Authorize]
@* MỞ KHÓA 2 DÒNG NÀY ĐỂ PHÂN QUYỀN *@
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Quản lý Sửa chữa & Bảo trì</PageTitle>

@* --- 1. HEADER & FILTER --- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-danger fw-bold mb-0"><i class="bi bi-tools me-2"></i>Sửa chữa & Bảo trì</h3>
        <small class="text-muted">Theo dõi sự cố, chi phí và thay thế linh kiện</small>
    </div>

    <div class="d-flex gap-2 align-items-end">
        @* Ô Từ ngày *@
        <div>
            <label class="form-label fw-bold small text-muted mb-0">Từ ngày:</label>
            <input type="date" class="form-control" @bind="fromDate" format-value="yyyy-MM-dd" />
        </div>
        @* Ô Đến ngày *@
        <div>
            <label class="form-label fw-bold small text-muted mb-0">Đến ngày:</label>
            <input type="date" class="form-control" @bind="toDate" format-value="yyyy-MM-dd" />
        </div>

        @* Nút Lọc theo ngày *@
        <button class="btn btn-primary fw-bold shadow-sm" @onclick="LoadData" title="Xem theo ngày đã chọn">
            <i class="bi bi-search"></i>
        </button>

        @* Nút Xem tất cả (Reset) *@
        <button class="btn btn-outline-secondary fw-bold shadow-sm" @onclick="ShowAll" title="Xem tất cả lịch sử">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Tất cả
        </button>

        @* 🚀 [ĐÃ THÊM ID] Nút Lập tờ trình *@
        <button id="btn-lap-to-trinh" class="btn btn-danger shadow-sm fw-bold ms-2" @onclick="OpenCreateModal">
            <i class="bi bi-file-earmark-plus me-2"></i> Lập Tờ Trình
        </button>
    </div>
</div>

@* --- 2. THANH TRẠNG THÁI (TABS) --- *@
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-2 d-flex gap-2">
        <button class="btn @(currentTab == -1 ? "btn-secondary" : "btn-outline-secondary") position-relative" @onclick="() => FilterByStatus(-1)">
            Tất cả <span class="badge bg-white text-dark ms-1">@allTickets.Length</span>
        </button>
        <button class="btn @(currentTab == 0 ? "btn-danger" : "btn-outline-danger") position-relative" @onclick="() => FilterByStatus(0)">
            <i class="bi bi-exclamation-circle me-1"></i> Mới báo
            @if (CountStatus(0) > 0)
            {
                <span class="badge bg-white text-danger ms-1">@CountStatus(0)</span>
            }
        </button>
        <button class="btn @(currentTab == 1 ? "btn-warning text-dark" : "btn-outline-warning text-dark") position-relative" @onclick="() => FilterByStatus(1)">
            <i class="bi bi-hourglass-split me-1"></i> Chờ xử lý
            @if (CountStatus(1) > 0)
            {
                <span class="badge bg-dark text-warning ms-1">@CountStatus(1)</span>
            }
        </button>
        <button class="btn @(currentTab == 2 ? "btn-success" : "btn-outline-success") position-relative" @onclick="() => FilterByStatus(2)">
            <i class="bi bi-check-circle me-1"></i> Đã sửa xong
            @if (CountStatus(2) > 0)
            {
                <span class="badge bg-white text-success ms-1">@CountStatus(2)</span>
            }
        </button>
    </div>
</div>

@* --- 3. TABLE DANH SÁCH --- *@
<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        @if (isLoading)
        {
            <div class="text-center my-5 py-5"><div class="spinner-border text-danger" role="status"></div></div>
        }
        else if (pagedTickets.Length == 0)
        {
            <div class="text-center my-5 py-5 text-muted"><i class="bi bi-clipboard-x fs-1"></i><p class="mt-2">Chưa có phiếu sửa chữa nào trong khoảng thời gian này.</p></div>
        }
        else
        {
            @* 🚀 [ĐÃ THÊM ID] TABLE *@
            <table id="table-trang-thai" class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã Phiếu</th>
                        <th>Thiết bị hỏng</th>
                        <th>Người báo (Khoa)</th>
                        <th>Ngày báo</th>
                        <th>Trạng thái</th>
                        <AuthorizeView Roles="Admin,SuperAdmin">
                            <Authorized><th>Chi phí</th></Authorized>
                        </AuthorizeView>
                        <th class="text-center" style="min-width: 150px;">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in pagedTickets)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.TicketID</td>
                            <td>
                                <div class="fw-bold text-primary">@(item.Asset?.AssetName ?? "Chưa xác định")</div>
                                <small class="text-muted">@item.Description</small>
                                @if (!string.IsNullOrEmpty(item.DinhKemUrl))
                                {
                                    <div class="mt-1">
                                        @if (IsImageFile(item.LoaiFile, item.DinhKemUrl))
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-image text-primary"></i> Ảnh đính kèm</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-film text-danger"></i> Video đính kèm</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.ReporterName</div>
                                <span class="badge bg-light text-dark border">@item.Department?.DeptName</span>
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="badge bg-danger">Mới báo</span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                }
                                else if (item.Status == 2)
                                {
                                    <span class="badge bg-success">Đã sửa xong</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Hủy</span>
                                }
                            </td>
                            <AuthorizeView Roles="Admin,SuperAdmin">
                                <Authorized>
                                    <td class="fw-bold text-danger">@(item.Status == 2 ? string.Format("{0:N0} đ", item.Cost) : "-")</td>
                                </Authorized>
                            </AuthorizeView>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDetailModal(item)" title="Xem chi tiết"><i class="bi bi-eye"></i></button>
                                    <AuthorizeView Roles="Admin,SuperAdmin">
                                        <Authorized Context="authContext">
                                            @if (item.Status == 0)
                                            {
                                                <button class="btn btn-sm btn-warning fw-bold text-dark" @onclick="() => ReceiveTicket(item)" title="Tiếp nhận">
                                                    <i class="bi bi-check2-square"></i> Đã nhận
                                                </button>
                                            }
                                            else if (item.Status == 1)
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick="() => OpenProcessModal(item)" title="Xử lý">
                                                    <i class="bi bi-tools"></i> Xử lý
                                                </button>
                                            }
                                            else if (item.Status == 2)
                                            {
                                                <button class="btn btn-sm btn-info text-white" @onclick="() => OpenWordPreview(item)" title="Xem trước / In biên bản">
                                                    <i class="bi bi-printer"></i>
                                                </button>
                                            }
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (pagedTickets.Length > 0)
    {
        <div class="card-footer bg-white border-0 py-3">
            <Pagination CurrentPage="@currentPage" TotalItems="@filteredTickets.Length" PageSize="@pageSize" OnPageChanged="ChangePage" />
        </div>
    }
</div>

@* 🚀 [ĐÃ THÊM] NÚT CUTE NỔI BỒNG BỀNH *@
<button class="cute-help-btn shadow-lg" @onclick="RunTour" title="Xem lại hướng dẫn">
    <i class="bi bi-patch-question-fill fs-5 me-1"></i> Hướng dẫn sử dụng
</button>

<style>
    .cute-help-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background-color: #3b82f6;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: bold;
        display: flex;
        align-items: center;
        z-index: 9999;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .cute-help-btn:hover {
            transform: scale(1.05) translateY(-3px);
            background-color: #2563eb;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.5) !important;
        }
</style>

@* --- 4. CÁC MODAL --- *@

@* MODAL TẠO MỚI *@
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div id="modal-lap-to-trinh" class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Lập Tờ Trình Báo Hỏng</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="card p-3 shadow-sm border-0">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="fw-bold small text-secondary">Người đề nghị:</label><input type="text" class="form-control fw-bold" @bind="newTicketRequest.ReporterName" /></div>
                            <div class="col-md-6"><label class="fw-bold small text-secondary">Chức vụ:</label><input type="text" class="form-control" @bind="newTicketRequest.ReporterPosition" /></div>
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Thiết bị hỏng:</label>
                                @if (!isUnknownDevice)
                                {
                                    <select class="form-select" @bind="newTicketRequest.AssetID">
                                        <option value="">-- Chọn thiết bị --</option>
                                        @foreach (var a in devices)
                                        {
                                            <option value="@a.AssetID">@a.AssetName (@a.Location)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control bg-light text-muted" value="Chưa xác định" disabled />
                                }
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkUnknown" @bind="isUnknownDevice">
                                    <label class="form-check-label small text-muted" for="chkUnknown">Không tìm thấy thiết bị / Chưa xác định</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Khoa / Phòng:</label>
                                <select class="form-select fw-bold" @bind="newTicketRequest.DepartmentID">
                                    <option value="">-- Chọn khoa --</option>
                                    @foreach (var d in departments)
                                    {
                                        <option value="@d.DepartmentID">@d.DeptName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-12"><label class="fw-bold small text-secondary">Mô tả lỗi:</label><textarea class="form-control" rows="3" @bind="newTicketRequest.Description"></textarea></div>
                            <div class="col-md-12"><label class="fw-bold small text-secondary">File đính kèm (Nếu không biết tên thiết bị thì hãy chụp ảnh gửi vào đây):</label><InputFile OnChange="HandleFileSelected" class="form-control" /></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btn-close-modal" class="btn btn-secondary" @onclick="() => showCreateModal = false">Hủy</button>
                    <button class="btn btn-danger" @onclick="SubmitCreate">Gửi</button>
                </div>
            </div>
        </div>
    </div>
}

@* MODAL XỬ LÝ *@
@if (showProcessModal && currentTicket != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Xử lý sự cố #@currentTicket.TicketID</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showProcessModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning"><strong>@currentTicket.ReporterName</strong> báo: @currentTicket.Description</div>
                    @if (!string.IsNullOrEmpty(currentTicket.DinhKemUrl))
                    {
                        <div class="mb-3 text-center border p-2 bg-light">
                            @if (IsImageFile(currentTicket.LoaiFile, currentTicket.DinhKemUrl))
                            {
                                <img src="@currentTicket.DinhKemUrl" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                            }
                            else
                            {
                                <video controls class="w-100 rounded shadow-sm" style="max-height: 300px;"><source src="@currentTicket.DinhKemUrl" type="video/mp4"></video>
                            }
                        </div>
                    }
                    <label>Giải pháp:</label><textarea class="form-control mb-3" @bind="completeRequest.Solution"></textarea>

                    <label class="fw-bold text-primary small">Linh kiện thay thế (Gõ để tìm):</label>
                    <div class="input-group mb-2 shadow-sm">
                        <input type="text" class="form-control" placeholder="Tìm tên linh kiện..."
                               @bind="partSearchKeyword" @bind:event="oninput" style="max-width: 200px;" />

                        <select class="form-select fw-bold" @bind="tempSelectedPartId">
                            <option value="0">-- Chọn linh kiện (@FilteredParts.Count()) --</option>
                            @foreach (var p in FilteredParts)
                            {
                                <option value="@p.AssetID">@p.AssetName (@p.AssetTypeName) - Tồn: @p.Quantity</option>
                            }
                        </select>

                        <input type="number" class="form-control" style="width:80px" @bind="tempQuantity" min="1" />
                        <button class="btn btn-success fw-bold" @onclick="AddPartToTable">
                            <i class="bi bi-plus-lg"></i> Thêm
                        </button>
                    </div>

                    @if (selectedParts.Any())
                    {
                        <ul class="list-group">
                            @foreach (var item in selectedParts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@item.AssetName (SL: @item.Quantity)</span>
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemovePart(item)">X</button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showProcessModal = false">Hủy</button>
                    <button class="btn btn-primary" @onclick="SubmitComplete">Hoàn thành</button>
                </div>
            </div>
        </div>
    </div>
}

@* MODAL CHI TIẾT *@
@if (showDetailModal && currentTicket != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">Chi tiết phiếu #@currentTicket.TicketID</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <h6 class="fw-bold text-primary border-bottom pb-2">1. Thông tin báo hỏng</h6>
                            <p class="mb-1"><b>Người báo:</b> @currentTicket.ReporterName - @currentTicket.Department?.DeptName</p>
                            <p class="mb-1"><b>Thiết bị:</b> <span class="fw-bold text-danger">@(currentTicket.Asset?.AssetName ?? "Chưa xác định")</span></p>
                            <p class="mb-1"><b>Mô tả lỗi:</b> @currentTicket.Description</p>
                            @if (!string.IsNullOrEmpty(currentTicket.DinhKemUrl))
                            {
                                <div class="mt-3 p-2 border rounded bg-white text-center">
                                    <small class="text-muted d-block mb-1">Ảnh/Video đính kèm:</small>
                                    @if (IsImageFile(currentTicket.LoaiFile, currentTicket.DinhKemUrl))
                                    {
                                        <img src="@currentTicket.DinhKemUrl" class="img-fluid rounded" style="max-height: 250px;" />
                                    }
                                    else
                                    {
                                        <video controls class="w-100" style="max-height: 250px;"><source src="@currentTicket.DinhKemUrl" type="video/mp4"></video>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (currentTicket.Status == 2)
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="fw-bold text-success border-bottom pb-2">2. Kết quả xử lý</h6>
                                <p class="mb-1"><b>Giải pháp:</b> @currentTicket.Solution</p>
                                <p class="mb-1"><b>Linh kiện:</b> @currentTicket.Note</p>
                                <p class="mb-1"><b>Hoàn thành:</b> @currentTicket.RepairDate?.ToString("dd/MM/yyyy HH:mm")</p>
                                <AuthorizeView Roles="Admin,SuperAdmin">
                                    <Authorized>
                                        <p class="mb-0 fw-bold text-danger"><b>Chi phí:</b> @string.Format("{0:N0}", currentTicket.Cost) đ</p>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer"><button class="btn btn-secondary" @onclick="() => showDetailModal = false">Đóng</button></div>
            </div>
        </div>
    </div>
}

@* MODAL XEM TRƯỚC VÀ NÚT TẢI FILE WORD *@
@if (showWordPreviewModal && currentTicket != null)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050; background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">

                <div class="modal-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                    <h5 class="modal-title mb-0"><i class="bi bi-file-text me-2"></i>Xem trước Bản in (#@currentTicket.TicketID)</h5>
                    <div>
                        <button class="btn btn-primary btn-sm fw-bold me-2 shadow-sm" @onclick="() => DownloadWord(currentTicket.TicketID)">
                            <i class="bi bi-download me-1"></i> Tải file .docx
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showWordPreviewModal = false"></button>
                    </div>
                </div>

                <div class="modal-body bg-secondary p-4 d-flex justify-content-center" style="overflow-y: auto;">
                    <div class="bg-white text-dark p-5 shadow" style="width: 210mm; min-height: 297mm; font-family: 'Times New Roman', Times, serif; font-size: 14pt; line-height: 1.5;">

                        <div class="row text-center mb-4">
                            <div class="col-5">
                                <p class="fw-bold mb-0">BỆNH VIỆN ĐK HẢI DƯƠNG</p>
                                <p class="fw-bold text-decoration-underline mb-0">PHÒNG CÔNG NGHỆ THÔNG TIN</p>
                            </div>
                            <div class="col-7">
                                <p class="fw-bold mb-0">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</p>
                                <p class="fw-bold text-decoration-underline mb-0">Độc lập – Tự do – Hạnh phúc</p>
                            </div>
                        </div>

                        <div class="text-center mb-4 mt-5">
                            <h3 class="fw-bold mb-1">BIÊN BẢN</h3>
                            <p class="fst-italic">Xác định tình trạng hư hỏng linh kiện thay thế trang thiết bị</p>
                        </div>

                        <p style="text-indent: 30px;">
                            Thời gian thiết lập biên bản: @(currentTicket.RepairDate?.ToString("HH") ?? DateTime.Now.ToString("HH")) giờ,
                            ngày @(currentTicket.RepairDate?.ToString("dd") ?? DateTime.Now.ToString("dd"))
                            tháng @(currentTicket.RepairDate?.ToString("MM") ?? DateTime.Now.ToString("MM"))
                            năm @(currentTicket.RepairDate?.ToString("yyyy") ?? DateTime.Now.ToString("yyyy"))
                        </p>
                        <p style="text-indent: 30px;">Tại khoa, phòng: <strong>@currentTicket.Department?.DeptName</strong> - Bệnh viện đa khoa Hải Dương.</p>

                        <p class="fw-bold mt-3">* Thành phần:</p>
                        <p>
                            1. Phòng Công nghệ thông tin:<br />
                            - Ông (bà): Nguyễn Thị Hương <span style="display:inline-block; width: 50px;"></span> Chức vụ: P.Trưởng phòng Công nghệ thông tin
                        </p>
                        <p>
                            2. Khoa – phòng đề nghị sửa chữa:<br />
                            - Ông (bà): @currentTicket.ReporterName <span style="display:inline-block; width: 50px;"></span> Chức vụ: @(string.IsNullOrEmpty(currentTicket.ReporterPosition) ? "Nhân viên" : currentTicket.ReporterPosition)
                        </p>
                        <p>
                            3. Ban giám sát:<br />
                            - Ông (bà): ................................. <span style="display:inline-block; width: 50px;"></span> Chức vụ: Ban giám sát .
                        </p>

                        <p class="mt-4"><strong>I. Tên thiết bị:</strong> @(currentTicket.Asset?.AssetName ?? "....................") <span style="display:inline-block; width: 30px;"></span> <strong>Model:</strong> (Không có)</p>
                        <p><strong>II. Tình trạng hư hỏng:</strong> @currentTicket.Description</p>
                        <p><strong>III. Biện pháp khắc phục:</strong> @currentTicket.Solution</p>
                        <p><strong>IV. Linh kiện thay thế:</strong> <span class="ms-2">@currentTicket.Note</span></p>

                        <p class="mt-5 text-justify">
                            Các bên đã thống nhất qua các nội dung trên và cùng ký.<br />
                            Đề nghị lãnh đạo Bệnh viện xem xét giải quyết./.
                        </p>

                        <div class="row text-center mt-4">
                            <div class="col-4 fw-bold">KHOA - PHÒNG<br /><br /><br /><br /><br />@currentTicket.ReporterName</div>
                            <div class="col-4 fw-bold">BAN GIÁM SÁT</div>
                            <div class="col-4 fw-bold">CÔNG NGHỆ THÔNG TIN<br /><br /><br /><br /><br />Nguyễn Thị Hương</div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private RepairTicket[] allTickets = Array.Empty<RepairTicket>();
    private RepairTicket[] filteredTickets = Array.Empty<RepairTicket>();
    private RepairTicket[] pagedTickets = Array.Empty<RepairTicket>();
    private int currentPage = 1;
    private int pageSize = 15;
    private int currentTab = -1;

    private DateTime fromDate = DateTime.Now.AddDays(-30);
    private DateTime toDate = DateTime.Now;

    private bool showCreateModal = false;
    private bool showProcessModal = false;
    private bool showReportModal = false;
    private bool showDetailModal = false;

    private bool showWordPreviewModal = false;

    private RepairTicket? currentTicket;
    private RepairTicket? previewTicket;

    private CreateRepairRequest newTicketRequest = new CreateRepairRequest();
    private CompleteRepairRequest completeRequest = new CompleteRepairRequest();
    private string? uploadedFileUrl;
    private string? previewUrl;
    private bool isFileImage = true;

    private Asset[] devices = Array.Empty<Asset>();
    private Asset[] parts = Array.Empty<Asset>();
    private Department[] departments = Array.Empty<Department>();

    private int tempSelectedPartId = 0;
    private int tempQuantity = 1;
    private List<PartDisplayModel> selectedParts = new List<PartDisplayModel>();
    private string partSearchKeyword = "";
    private bool isUnknownDevice = false;
    private IEnumerable<Asset> FilteredParts => string.IsNullOrWhiteSpace(partSearchKeyword) ? parts : parts.Where(x => x.AssetName.Contains(partSearchKeyword, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAssets();
        await LoadDepartments();
        await LoadData();
    }

    // 🚀 [ĐÃ THÊM] AUTO CHẠY TOUR KHI VỪA VÀO TRANG LẦN ĐẦU
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var hasSeenTour = await JS.InvokeAsync<string>("localStorage.getItem", "hasSeenRepairTour");
            if (string.IsNullOrEmpty(hasSeenTour))
            {
                await RunTour();
            }
        }
    }

    // 🚀 [ĐÃ THÊM] HÀM CHẠY JS
    private async Task RunTour()
    {
        await JS.InvokeVoidAsync("startTour");
        await JS.InvokeVoidAsync("localStorage.setItem", "hasSeenRepairTour", "true");
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            string fDate = fromDate.ToString("yyyy-MM-dd");
            string tDate = toDate.ToString("yyyy-MM-dd") + "T23:59:59";

            allTickets = await Http.GetFromJsonAsync<RepairTicket[]>($"api/admin/repairs?from={fDate}&to={tDate}") ?? Array.Empty<RepairTicket>();

            FilterByStatus(currentTab);
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isLoading = false;
        }
    }

    private async Task ShowAll()
    {
        fromDate = new DateTime(2020, 1, 1);
        toDate = DateTime.Now;
        await LoadData();
    }

    private async Task LoadAssets()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<Asset[]>("api/admin/assets");
            if (res != null)
            {
                devices = res.Where(x => x.AssetTypeID >= 1 && x.AssetTypeID <= 4).ToArray();
                parts = res.Where(x => x.AssetTypeID >= 5).ToArray();
            }
        }
        catch { }
    }
    private async Task LoadDepartments() { try { var res = await Http.GetFromJsonAsync<Department[]>("api/admin/departments"); if (res != null) departments = res; } catch { } }

    private void FilterByStatus(int status)
    {
        currentTab = status;
        currentPage = 1;
        filteredTickets = status == -1 ? allTickets : allTickets.Where(x => x.Status == status).ToArray();
        UpdatePagedList();
    }

    private int CountStatus(int s) => allTickets.Count(x => x.Status == s);
    private void UpdatePagedList() => pagedTickets = filteredTickets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToArray();
    private void ChangePage(int p) { currentPage = p; UpdatePagedList(); }

    private async Task ReceiveTicket(RepairTicket item)
    {
        var res = await Http.PutAsJsonAsync($"api/repairs/{item.TicketID}/status", 1);
        if (res.IsSuccessStatusCode) await LoadData();
        else await JS.InvokeVoidAsync("alert", "Lỗi cập nhật trạng thái!");
    }

    private void OpenProcessModal(RepairTicket t)
    {
        currentTicket = t;
        completeRequest = new CompleteRepairRequest();
        selectedParts = new List<PartDisplayModel>();
        showProcessModal = true;
    }

    // 🚀 CHẶN LƯU NẾU QUÊN BẤM NÚT "+ THÊM"
    private async Task SubmitComplete()
    {
        if (currentTicket == null) return;

        // KIỂM TRA: Đã chọn linh kiện ở Dropdown nhưng chưa ấn "+ Thêm"
        if (tempSelectedPartId != 0)
        {
            await JS.InvokeVoidAsync("alert", "Bạn đang chọn linh kiện nhưng chưa ấn nút '+ Thêm'. Vui lòng Thêm linh kiện vào danh sách hoặc chọn lại '-- Chọn linh kiện --' trước khi Hoàn thành!");
            return; // Dừng luôn, không cho gửi API
        }

        completeRequest.Parts = selectedParts.Select(x => new RepairItemDto { AssetId = x.AssetId, Quantity = x.Quantity }).ToList();
        var res = await Http.PostAsJsonAsync($"api/repairs/{currentTicket.TicketID}/complete", completeRequest);
        if (res.IsSuccessStatusCode) { showProcessModal = false; await LoadData(); await JS.InvokeVoidAsync("alert", "Đã xử lý xong!"); }
        else await JS.InvokeVoidAsync("alert", "Lỗi xử lý!");
    }

    private void OpenWordPreview(RepairTicket t)
    {
        currentTicket = t;
        showWordPreviewModal = false;
        StateHasChanged();
        showWordPreviewModal = true;
    }

    private async Task DownloadWord(int id)
    {
        try
        {
            var res = await Http.GetAsync($"api/repairs/export-word/{id}");
            if (res.IsSuccessStatusCode)
            {
                var stream = await res.Content.ReadAsStreamAsync();
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", $"BienBan_{id}.docx", streamRef);
            }
        }
        catch { await JS.InvokeVoidAsync("alert", "Lỗi tải file!"); }
    }

    private void OpenCreateModal() { showCreateModal = true; newTicketRequest = new CreateRepairRequest { ReportDate = DateTime.Now }; isUnknownDevice = false; }
    private void OpenDetailModal(RepairTicket t) { currentTicket = t; showDetailModal = true; }
    private void OpenReportPreview(RepairTicket t) { previewTicket = t; showReportModal = true; }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file == null) return;
        var type = file.ContentType.ToLower();
        var name = file.Name.ToLower();
        isFileImage = type.Contains("image") || name.EndsWith(".png") || name.EndsWith(".jpg") || name.EndsWith(".jpeg") || name.EndsWith(".gif");

        var content = new MultipartFormDataContent();
        content.Add(new StreamContent(file.OpenReadStream(100 * 1024 * 1024)), "file", file.Name);
        var res = await Http.PostAsync("api/Upload", content);
        if (res.IsSuccessStatusCode)
        {
            var r = await res.Content.ReadFromJsonAsync<UploadResult>();
            uploadedFileUrl = r?.Url;
            previewUrl = uploadedFileUrl;
        }
    }

    private async Task SubmitCreate()
    {
        if (!isUnknownDevice && newTicketRequest.AssetID == 0) { await JS.InvokeVoidAsync("alert", "Chọn thiết bị!"); return; }
        if (isUnknownDevice) newTicketRequest.AssetID = null;
        newTicketRequest.DinhKemUrl = uploadedFileUrl;
        newTicketRequest.LoaiFile = isFileImage ? "Image" : "Video";

        var res = await Http.PostAsJsonAsync("api/repairs", newTicketRequest);
        if (res.IsSuccessStatusCode) { showCreateModal = false; await LoadData(); }
    }

    // 🚀 BÁO LỖI HẾT HÀNG & TỰ ĐỘNG RESET DROPDOWN
    private async Task AddPartToTable()
    {
        if (tempSelectedPartId == 0) return;

        var p = parts.FirstOrDefault(x => x.AssetID == tempSelectedPartId);
        if (p != null)
        {
            if (p.Quantity <= 0)
            {
                await JS.InvokeVoidAsync("alert", $"Linh kiện '{p.AssetName}' đã hết hàng! Vui lòng nhập thêm vào kho.");
                return;
            }

            int currentAdded = selectedParts.Where(x => x.AssetId == p.AssetID).Sum(x => x.Quantity);
            if (tempQuantity <= 0)
            {
                await JS.InvokeVoidAsync("alert", "Số lượng phải lớn hơn 0!");
                return;
            }
            if (tempQuantity + currentAdded > p.Quantity)
            {
                await JS.InvokeVoidAsync("alert", $"Chỉ còn {p.Quantity} cái. Không thể thêm vượt quá số lượng tồn kho!");
                return;
            }

            selectedParts.Add(new PartDisplayModel { AssetId = p.AssetID, AssetName = p.AssetName, Quantity = tempQuantity });

            // 🚀 Reset dropdown sau khi bấm Thêm thành công
            tempSelectedPartId = 0;
            tempQuantity = 1;
        }
    }

    private void RemovePart(PartDisplayModel item) => selectedParts.Remove(item);

    private bool IsImageFile(string? loaiFile, string? url)
    {
        if (loaiFile == "Image") return true;
        if (!string.IsNullOrEmpty(url))
        {
            var u = url.ToLower();
            if (u.EndsWith(".jpg") || u.EndsWith(".jpeg") || u.EndsWith(".png") || u.EndsWith(".gif")) return true;
        }
        return false;
    }

    // DTOs
    public class RepairTicket
    {
        public int TicketID { get; set; }
        public string Description { get; set; } = string.Empty;
