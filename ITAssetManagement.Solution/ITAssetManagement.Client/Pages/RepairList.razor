        public decimal Cost { get; set; }
        public string ReporterName { get; set; } = string.Empty;
        public Asset? Asset { get; set; }
        public Department? Department { get; set; }
        public string? DinhKemUrl { get; set; }
        public string? LoaiFile { get; set; }
        public string? Solution { get; set; }
        public string? Note { get; set; }
        public DateTime? RepairDate { get; set; }
        public string? ReporterPosition { get; set; }
    }

    public class Asset
    {
        public int AssetID { get; set; }
        public string AssetName { get; set; } = string.Empty;
        public string AssetTypeName { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public int AssetTypeID { get; set; }
    }

    public class Department
    {
        public int DepartmentID { get; set; }
        public string DeptName { get; set; } = string.Empty;
    }

    public class CreateRepairRequest
    {
        public string ReporterName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime ReportDate { get; set; }
        public string? DinhKemUrl { get; set; }
        public string? LoaiFile { get; set; }
        public int? AssetID { get; set; }
        public int? DepartmentID { get; set; }
        public string? ReporterPosition { get; set; }
    }

    public class CompleteRepairRequest
    {
        public string Solution { get; set; } = string.Empty;
        public List<RepairItemDto> Parts { get; set; } = new();
    }

    public class RepairItemDto
    {
        public int AssetId { get; set; }
        public int Quantity { get; set; }
    }

    public class PartDisplayModel
    {
        public int AssetId { get; set; }
        public string AssetName { get; set; } = string.Empty;
        public int Quantity { get; set; }
    }

    public class MyInfoDTO
    {
        public string FullName { get; set; }
        public int DepartmentID { get; set; }
    }

    public class UploadResult
    {
        public string Url { get; set; }
    }
}