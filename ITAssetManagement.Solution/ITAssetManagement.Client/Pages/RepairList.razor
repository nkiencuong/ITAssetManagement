@page "/repairs"
@using ITAssetManagement.Client.Models
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Quản lý Sửa chữa & Bảo trì</PageTitle>

@* --- 1. HEADER & FILTER --- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-danger fw-bold mb-0"><i class="bi bi-tools me-2"></i>Sửa chữa & Bảo trì</h3>
        <small class="text-muted">Theo dõi sự cố, chi phí và thay thế linh kiện</small>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white text-danger"><i class="bi bi-calendar3"></i></span>
            <input type="date" class="form-control" @onchange="FilterByDate" />
            <button class="btn btn-outline-secondary" @onclick="ReloadOriginalData" title="Xem tất cả">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        <button class="btn btn-danger shadow-sm fw-bold" @onclick="OpenCreateModal">
            <i class="bi bi-file-earmark-plus me-2"></i> Lập Tờ Trình
        </button>
    </div>
</div>

@* --- 2. TABLE DANH SÁCH --- *@
<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        @if (isLoading)
        {
            <div class="text-center my-5 py-5"><div class="spinner-border text-danger" role="status"></div></div>
        }
        else if (tickets.Length == 0)
        {
            <div class="text-center my-5 py-5 text-muted"><i class="bi bi-clipboard-x fs-1"></i><p class="mt-2">Chưa có phiếu sửa chữa nào.</p></div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã Phiếu</th>
                        <th>Thiết bị hỏng</th>
                        <th>Người báo (Khoa)</th>
                        <th>Ngày báo</th>
                        <th>Trạng thái</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized><th>Chi phí</th></Authorized>
                        </AuthorizeView>
                        <th class="text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in pagedTickets)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.TicketID</td>
                            <td>
                                <div class="fw-bold text-primary">@(item.Asset?.AssetName ?? "Chưa xác định")</div>
                                <small class="text-muted">@item.Description</small>
                                @if (!string.IsNullOrEmpty(item.DinhKemUrl))
                                {
                                    <div class="mt-1">
                                        @if (item.LoaiFile == "Image")
                                        {
                                            <span class="badge bg-light text-dark border"><i class="bi bi-image text-primary"></i> Ảnh đính kèm</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-light text-dark border"><i class="bi bi-film text-danger"></i> Video đính kèm</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.ReporterName</div>
                                <span class="badge bg-light text-dark border">@item.Department?.DeptName</span>
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == 0)
                                {
                                    <span class="badge bg-danger">Mới báo</span>
                                }
                                else if (item.Status == 2)
                                {

                                    <span class="badge bg-success">Đã sửa xong</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Hủy</span>
                                }
                            </td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="fw-bold text-danger">@(item.Status == 2 ? string.Format("{0:N0} đ", item.Cost) : "-")</td>
                                </Authorized>
                            </AuthorizeView>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDetailModal(item)" title="Xem chi tiết"><i class="bi bi-eye"></i></button>
                                    @if (item.Status == 0)
                                    {
                                        <AuthorizeView Roles="Admin">
                                            <Authorized Context="authContext">
                                                <button class="btn btn-sm btn-primary" @onclick="() => OpenProcessModal(item)">Xử lý</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                    else if (item.Status == 2)
                                    {
                                        <AuthorizeView Roles="Admin">
                                            <Authorized Context="authContext">
                                                <button class="btn btn-sm btn-info text-white" @onclick="() => OpenReportPreview(item)"><i class="bi bi-printer"></i></button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (tickets.Length > 0)
    {
        <div class="card-footer bg-white border-0 py-3">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")"><button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Trước</button></li>
                    <li class="page-item disabled"><span class="page-link">Trang @currentPage</span></li>
                    <li class="page-item @(currentPage* pageSize >= tickets.Length ? "disabled" : "")"><button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Sau</button></li>
                </ul>
            </nav>
        </div>
    }
</div>

@* --- 3. MODAL XEM TRƯỚC IN ẤN (CÓ NÚT DOWNLOAD) --- *@
@if (showReportModal && previewTicket != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-printer me-2"></i>Xem trước Biên Bản</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showReportModal = false"></button>
                </div>
                <div class="modal-body bg-light d-flex justify-content-center" style="max-height: 80vh; overflow-y: auto;">
                    <div class="a4-paper shadow-sm">
                        <div class="d-flex justify-content-between text-center mb-4 fw-bold" style="font-size: 11pt;">
                            <div style="width:45%">BỆNH VIỆN ĐK HẢI DƯƠNG<br>PHÒNG CÔNG NGHỆ THÔNG TIN</div>
                            <div style="width:55%">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM<br>Độc lập – Tự do – Hạnh phúc<br>-------------------</div>
                        </div>
                        <div class="text-center mb-3">
                            <h4 class="fw-bold mb-1">BIÊN BẢN</h4>
                            <h5 class="fw-bold mb-2 fst-italic">Xác định tình trạng hư hỏng linh kiện thay thế trang thiết bị</h5>
                            <div class="fst-italic small">Thời gian: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")<br>Tại: @previewTicket.Department?.DeptName</div>
                        </div>
                        <div class="mb-2"><b>I. Tên thiết bị:</b> <span class="text-uppercase fw-bold">@(previewTicket.Asset?.AssetName ?? "....................")</span></div>
                        <div class="mb-2"><b>II. Tình trạng hư hỏng:</b> <span class="text-primary">@previewTicket.Description</span></div>
                        <div class="mb-2"><b>III. Biện pháp khắc phục:</b> <textarea class="input-inline w-100 p-1" rows="2" @bind="previewTicket.Solution"></textarea></div>
                        <div class="mb-4"><b>IV. Linh kiện thay thế:</b> <textarea class="input-inline w-100 p-1" rows="2" @bind="previewTicket.Note"></textarea></div>
                        <div class="mb-5">Các bên đã thống nhất và cùng ký./.</div>
                        <div class="d-flex justify-content-between text-center fw-bold">
                            <div style="width:30%">KHOA – PHÒNG<br><br><br><br>@previewTicket.ReporterName</div>
                            <div style="width:30%">BAN GIÁM SÁT<br><br><br><br></div>
                            <div style="width:30%">CNTT<br><br><br><br>Nguyễn Thị Hương</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showReportModal = false">Đóng</button>
                    @* 👇 NÚT DOWNLOAD WORD ĐÂY RỒI *@
                    <button class="btn btn-primary fw-bold" @onclick="() => DownloadWord(previewTicket.TicketID)">
                        <i class="bi bi-file-word me-2"></i> Tải file Word
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* --- 4. MODAL TẠO MỚI --- *@
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Lập Tờ Trình Báo Hỏng</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="card p-3 shadow-sm border-0">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Người đề nghị:</label>
                                <input type="text" class="form-control fw-bold" @bind="newTicketRequest.ReporterName" />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Chức vụ:</label>
                                <input type="text" class="form-control" @bind="newTicketRequest.ReporterPosition" />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Khoa / Phòng:</label>
                                <select class="form-select fw-bold" @bind="newTicketRequest.DepartmentID">
                                    <option value="">-- Chọn Khoa --</option>
                                    @foreach (var d in departments)
                                    {
                                        <option value="@d.DepartmentID">@d.DeptName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold small text-secondary">Thiết bị hỏng:</label>
                                @if (!isUnknownDevice)
                                {
                                    <select class="form-select" @bind="newTicketRequest.AssetID">
                                        <option value="">-- Chọn thiết bị --</option>
                                        @foreach (var a in devices)
                                        {
                                            <option value="@a.AssetID">@a.AssetName (@a.Location)</option>
                                        }
                                    </select>
                                }
                                else
                                {

                                    <input type="text" class="form-control bg-light text-muted" value="Chưa xác định" disabled />
                                }
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkUnknown" @bind="isUnknownDevice">
                                    <label class="form-check-label small text-muted" for="chkUnknown">Không tìm thấy thiết bị</label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold small text-secondary">Mô tả hư hỏng:</label>
                                <textarea class="form-control" rows="3" @bind="newTicketRequest.Description"></textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold small text-secondary">Hình ảnh/Video minh họa (Nếu có):</label>
                                <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*,video/*" />
                                @if (!string.IsNullOrEmpty(previewUrl))
                                {
                                    <div class="mt-2 border p-2 rounded bg-white">
                                        @if (isFileImage)
                                        {
                                            <img src="@previewUrl" width="150" class="img-thumbnail" />
                                        }
                                        else
                                        {

                                            <video width="200" controls><source src="@previewUrl" type="video/mp4"></video>
                                        }
                                        <div class="text-success small mt-1"><i class="bi bi-check-circle-fill"></i> Đã tải lên!</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Hủy</button>
                    <button class="btn btn-danger fw-bold" @onclick="SubmitCreate">Gửi Tờ Trình</button>
                </div>
            </div>
        </div>
    </div>
}

@* --- 5. MODAL XỬ LÝ (ADMIN - CÓ HIỆN ẢNH) --- *@
@if (showProcessModal && currentTicket != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Xử lý sự cố #@currentTicket.TicketID</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showProcessModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong>@currentTicket.ReporterName</strong> báo: @currentTicket.Description
                        @if (currentTicket.Asset == null)
                        {
                            <div class="mt-1 fw-bold text-danger">⚠️ LƯU Ý: Người dùng chưa xác định thiết bị.</div>
                        }
                    </div>

                    @* Hiển thị Ảnh/Video ngay trong Modal Xử lý *@
                    @if (!string.IsNullOrEmpty(currentTicket.DinhKemUrl))
                    {
                        <div class="card mb-3 border-primary">
                            <div class="card-header bg-primary text-white py-1 small"><i class="bi bi-paperclip"></i> Ảnh/Video hiện trường</div>
                            <div class="card-body text-center bg-light p-2">
                                @if (currentTicket.LoaiFile == "Image")
                                {
                                    <img src="@currentTicket.DinhKemUrl" class="img-fluid rounded shadow-sm" style="max-height: 300px;" />
                                    <div class="mt-2"><a href="@currentTicket.DinhKemUrl" download target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i> Tải ảnh</a></div>
                                }
                                else if (currentTicket.LoaiFile == "Video")
                                {
                                    <video controls class="w-100 rounded shadow-sm" style="max-height: 300px;"><source src="@currentTicket.DinhKemUrl" type="video/mp4"></video>
                                    <div class="mt-2"><a href="@currentTicket.DinhKemUrl" download target="_blank" class="btn btn-sm btn-outline-danger"><i class="bi bi-download"></i> Tải video</a></div>
                                }
                            </div>
                        </div>
                    }

                    <label class="fw-bold">Giải pháp / Cách khắc phục:</label>
                    <textarea class="form-control mb-3" @bind="completeRequest.Solution" rows="3"></textarea>

                    <label class="fw-bold">Linh kiện thay thế (Trừ kho):</label>
                    <div class="card p-2 bg-light border-0 mb-3">
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text bg-white text-primary border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Tìm linh kiện (gõ tên)..." @bind="partSearchKeyword" @bind:event="oninput" />
                        </div>
                        <div class="d-flex gap-2">
                            <select class="form-select" @bind="tempSelectedPartId">
                                <option value="0">-- Chọn linh kiện (@FilteredParts.Count()) --</option>
                                @foreach (var p in FilteredParts)
                                {
                                    <option value="@p.AssetID">@p.AssetName (Còn: @p.Quantity)</option>
                                }
                            </select>
                            <input type="number" class="form-control" style="width:80px" @bind="tempQuantity" min="1" />
                            <button class="btn btn-success fw-bold" @onclick="AddPartToTable"><i class="bi bi-plus-lg"></i> Thêm</button>
                        </div>
                    </div>

                    @if (selectedParts.Any())
                    {
                        <ul class="list-group mb-3">
                            @foreach (var item in selectedParts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-gear-fill me-2 text-secondary"></i> @item.AssetName (SL: @item.Quantity)</span>
                                    <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => RemovePart(item)"><i class="bi bi-x-lg"></i></button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showProcessModal = false">Đóng</button>
                    <button class="btn btn-primary" @onclick="SubmitComplete">Hoàn thành & Trừ kho</button>
                </div>
            </div>
        </div>
    </div>
}

@* --- 6. MODAL CHI TIẾT --- *@
@if (showDetailModal && currentTicket != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">Chi tiết phiếu #@currentTicket.TicketID</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <h6 class="fw-bold text-primary border-bottom pb-2">1. Thông tin báo hỏng</h6>
                            <div class="row g-2">
                                <div class="col-6"><b>Người báo:</b> @currentTicket.ReporterName</div>
                                <div class="col-6"><b>Khoa/Phòng:</b> @currentTicket.Department?.DeptName</div>
                                <div class="col-12"><b>Thiết bị:</b> <span class="fw-bold text-danger">@(currentTicket.Asset?.AssetName ?? "Chưa xác định")</span></div>
                                <div class="col-12"><b>Mô tả lỗi:</b> @currentTicket.Description</div>
                            </div>

                            @if (!string.IsNullOrEmpty(currentTicket.DinhKemUrl))
                            {
                                <div class="mt-3 p-2 border rounded bg-white text-center">
                                    <small class="text-muted d-block mb-1">Ảnh/Video đính kèm:</small>
                                    @if (currentTicket.LoaiFile == "Image")
                                    {
                                        <img src="@currentTicket.DinhKemUrl" class="img-fluid rounded" style="max-height: 250px;" />
                                    }
                                    else
                                    {

                                        <video controls class="w-100" style="max-height: 250px;"><source src="@currentTicket.DinhKemUrl" type="video/mp4"></video>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (currentTicket.Status == 2)
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="fw-bold text-success border-bottom pb-2">2. Kết quả xử lý (Admin)</h6>
                                <p><b>Giải pháp:</b> @currentTicket.Solution</p>
                                <p><b>Linh kiện thay thế:</b> @currentTicket.Note</p>
                                <p><b>Ngày hoàn thành:</b> @currentTicket.RepairDate?.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">Phiếu này đang chờ xử lý...</div>
                    }
                </div>
                <div class="modal-footer"><button class="btn btn-secondary" @onclick="() => showDetailModal = false">Đóng</button></div>
            </div>
        </div>
    </div>
}

<style>
    .a4-paper {
        width: 210mm;
        min-height: 297mm;
        background: white;
        padding: 2cm 1.5cm;
        font-family: 'Times New Roman', serif;
        font-size: 13pt;
        line-height: 1.5;
        color: #000;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
    }</style>

@code {
    private bool isLoading = true;
    private RepairTicket[] tickets = Array.Empty<RepairTicket>();
    private RepairTicket[] allTickets = Array.Empty<RepairTicket>();
    private RepairTicket[] pagedTickets = Array.Empty<RepairTicket>();
    private int currentPage = 1;
    private int pageSize = 15;

    private Asset[] devices = Array.Empty<Asset>();
    private Asset[] parts = Array.Empty<Asset>();
    private Department[] departments = Array.Empty<Department>();

    private bool showCreateModal = false;
    private bool showProcessModal = false;
    private bool showReportModal = false;
    private bool showDetailModal = false;
    private bool isUnknownDevice = false;

    private CreateRepairRequest newTicketRequest = new CreateRepairRequest();
    private RepairTicket? currentTicket;
    private RepairTicket? previewTicket;
    private CompleteRepairRequest completeRequest = new CompleteRepairRequest();

    private string? uploadedFileUrl;
    private string? previewUrl;
    private bool isFileImage = true;

    private int tempSelectedPartId = 0;
    private int tempQuantity = 1;
    private List<PartDisplayModel> selectedParts = new List<PartDisplayModel>();
    private string partSearchKeyword = "";
    private IEnumerable<Asset> FilteredParts => string.IsNullOrWhiteSpace(partSearchKeyword) ? parts : parts.Where(x => x.AssetName.Contains(partSearchKeyword, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadData();
        await LoadAssets();
        await LoadDepartments();
        isLoading = false;
    }

    private async Task LoadData() { try { var res = await Http.GetFromJsonAsync<RepairTicket[]>("api/admin/repairs"); if (res != null) { allTickets = res; tickets = res; UpdatePagedList(); } } catch { } }
    private async Task LoadAssets() { try { var all = await Http.GetFromJsonAsync<Asset[]>("api/admin/assets"); if (all != null) { parts = all.Where(x => x.AssetTypeName.Contains("Linh kiện") || x.AssetTypeName.Contains("Vật tư")).ToArray(); devices = all.Where(x => !x.AssetTypeName.Contains("Linh kiện")).ToArray(); } } catch { } }
    private async Task LoadDepartments() { try { var res = await Http.GetFromJsonAsync<Department[]>("api/admin/departments"); if (res != null) departments = res; } catch { } }

    private void FilterByDate(ChangeEventArgs e) { if (DateTime.TryParse(e.Value?.ToString(), out DateTime d)) tickets = allTickets.Where(x => x.CreatedDate.Date == d.Date).ToArray(); else tickets = allTickets; currentPage = 1; UpdatePagedList(); }
    private void ReloadOriginalData() { tickets = allTickets; currentPage = 1; UpdatePagedList(); }
    private void UpdatePagedList() { if (tickets != null) pagedTickets = tickets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToArray(); }
    private void ChangePage(int page) { currentPage = page; UpdatePagedList(); }

    private async Task OpenCreateModal()
    {
        newTicketRequest = new CreateRepairRequest { ReportDate = DateTime.Now };
        uploadedFileUrl = null; previewUrl = null; isUnknownDevice = false;
        try { var me = await Http.GetFromJsonAsync<MyInfoDTO>("api/auth/me"); if (me != null) { newTicketRequest.ReporterName = me.FullName; newTicketRequest.DepartmentID = me.DepartmentID; } } catch { }
        showCreateModal = true;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file == null) return;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(file.OpenReadStream(100 * 1024 * 1024)), "file", file.Name);
            var response = await Http.PostAsync("api/Upload", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                uploadedFileUrl = result?.Url; previewUrl = uploadedFileUrl; isFileImage = file.ContentType.Contains("image");
            }
            else await JS.InvokeVoidAsync("alert", "Upload lỗi!");
        }
        catch { await JS.InvokeVoidAsync("alert", "Lỗi upload!"); }
    }

    private async Task SubmitCreate()
    {
        if (!isUnknownDevice && (newTicketRequest.AssetID == null || newTicketRequest.AssetID == 0)) { await JS.InvokeVoidAsync("alert", "Chưa chọn thiết bị!"); return; }
        if (isUnknownDevice) newTicketRequest.AssetID = null;
        newTicketRequest.DinhKemUrl = uploadedFileUrl; newTicketRequest.LoaiFile = isFileImage ? "Image" : "Video";
        var res = await Http.PostAsJsonAsync("api/repairs", newTicketRequest);
        if (res.IsSuccessStatusCode) { showCreateModal = false; await LoadData(); await JS.InvokeVoidAsync("alert", "Đã gửi!"); }
        else await JS.InvokeVoidAsync("alert", "Gửi thất bại!");
    }

    // 👇 HÀM DOWNLOAD WORD (ĐÃ THÊM LẠI)
    private async Task DownloadWord(int id)
    {
        try
        {
            var res = await Http.GetAsync($"api/repairs/export-word/{id}");
            if (res.IsSuccessStatusCode)
            {
                var stream = await res.Content.ReadAsStreamAsync();
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", $"BienBan_{id}.docx", streamRef);
            }
            else { await JS.InvokeVoidAsync("alert", "Lỗi tải file (API error)!"); }
        }
        catch { await JS.InvokeVoidAsync("alert", "Lỗi kết nối!"); }
    }

    private void OpenProcessModal(RepairTicket t)
    {
        currentTicket = t; completeRequest = new CompleteRepairRequest();
        selectedParts = new List<PartDisplayModel>(); tempSelectedPartId = 0; tempQuantity = 1; partSearchKeyword = "";
        showProcessModal = true;
    }
    private void OpenDetailModal(RepairTicket t) { currentTicket = t; showDetailModal = true; }
    private void OpenReportPreview(RepairTicket t) { previewTicket = t; showReportModal = true; }

    private void AddPartToTable()
    {
        var p = parts.FirstOrDefault(x => x.AssetID == tempSelectedPartId);
        if (p != null)
        {
            var existing = selectedParts.FirstOrDefault(x => x.AssetId == p.AssetID);
            if (existing != null) existing.Quantity += tempQuantity; else selectedParts.Add(new PartDisplayModel { AssetId = p.AssetID, AssetName = p.AssetName, Quantity = tempQuantity });
            tempSelectedPartId = 0; tempQuantity = 1;
        }
    }
    private void RemovePart(PartDisplayModel item) => selectedParts.Remove(item);

    private async Task SubmitComplete()
    {
        if (currentTicket == null) return;
        completeRequest.Parts = selectedParts.Select(x => new RepairItemDto { AssetId = x.AssetId, Quantity = x.Quantity }).ToList();
        var res = await Http.PostAsJsonAsync($"api/repairs/{currentTicket.TicketID}/complete", completeRequest);
        if (res.IsSuccessStatusCode) { showProcessModal = false; await LoadData(); await JS.InvokeVoidAsync("alert", "Đã xử lý!"); }
        else await JS.InvokeVoidAsync("alert", "Lỗi xử lý!");
    }

    public class CreateRepairRequest
    {
        public int? AssetID { get; set; }
        public int? DepartmentID { get; set; }
        public string Description { get; set; } = "";
        public DateTime ReportDate { get; set; } = DateTime.Now;
        public string ReporterName { get; set; } = "";
        public string ReporterPosition { get; set; } = "";
        public string? DinhKemUrl { get; set; }
        public string? LoaiFile { get; set; }
    }
    public class CompleteRepairRequest { public string Solution { get; set; } = ""; public List<RepairItemDto> Parts { get; set; } = new(); }
    public class RepairItemDto { public int AssetId { get; set; } public int Quantity { get; set; } }
    public class PartDisplayModel { public int AssetId { get; set; } public string AssetName { get; set; } = ""; public int Quantity { get; set; } }
    public class MyInfoDTO { public string FullName { get; set; } public int DepartmentID { get; set; } }
    public class UploadResult { public string Url { get; set; } }
}