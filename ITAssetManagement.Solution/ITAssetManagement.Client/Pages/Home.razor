                            </div>
                        </div>
                        <div class="leader-item border-0">
                            <div class="leader-avatar bg-blue-light text-primary"><i class="bi bi-star-fill"></i></div>
                            <div class="leader-info">
                                <h6 class="leader-name">KS. Nguyễn Thành Đông</h6>
                                <span class="leader-pos">PHÓ TRƯỞNG PHÒNG</span>
                            </div>
