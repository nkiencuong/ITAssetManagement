@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ITAssetManagement.Request.Reports
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@* @attribute [Authorize] *@

<PageTitle>Trang Chủ - Dashboard</PageTitle>

<div class="dashboard-container fade-in">

    @* --- 1. HERO SECTION --- *@
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">PHÒNG CÔNG NGHỆ THÔNG TIN</h1>
            <h3 class="hero-subtitle">Bệnh Viện Đa Khoa Hải Dương</h3>
            <div class="hero-quote">
                "Bệnh viện điện tử hướng tới tương lai - Hết việc chứ không hết giờ."
            </div>
        </div>
        <div class="hero-decoration">NKC</div>
    </div>

    @* --- 2. THỐNG KÊ (CLICK ĐỂ CHUYỂN TRANG) --- *@
    <AuthorizeView Roles="Admin,SuperAdmin">
        <Authorized>
            <div class="modern-card mb-4 p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-circle-sm bg-blue-light text-primary me-3">
                            <i class="bi bi-bar-chart-line-fill"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-dark text-uppercase">Tổng hợp số liệu sửa chữa</h5>
                    </div>

                    <div class="d-flex gap-2 align-items-center mt-3 mt-md-0 filter-group">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">Từ</span>
                            <input type="date" class="form-control" @bind="startDate" />
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">Đến</span>
                            <input type="date" class="form-control" @bind="endDate" />
                        </div>
                        <button class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="LoadStats">
                            <i class="bi bi-search me-1"></i> Lọc
                        </button>
                    </div>
                </div>

                <div class="row g-4">
                    @* TỔNG ĐƠN -> Tab Tất cả (-1) *@
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card blue" style="cursor: pointer;" @onclick='() => Nav.NavigateTo("/repairs?tab=-1")'>
                            <div class="stat-body">
                                <span class="stat-label">Tổng tiếp nhận</span>
                                <h2 class="stat-value">@stats.TotalReceived</h2>
                            </div>
                            <div class="stat-icon-bg"><i class="bi bi-journal-plus"></i></div>
                        </div>
                    </div>

                    @* ĐANG SỬA -> Tab Chờ xử lý (1) *@
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card orange" style="cursor: pointer;" @onclick='() => Nav.NavigateTo("/repairs?tab=1")'>
                            <div class="stat-body">
                                <span class="stat-label">Đang sửa chữa</span>
                                <h2 class="stat-value">@stats.Processing</h2>
                            </div>
                            <div class="stat-icon-bg"><i class="bi bi-gear-wide-connected"></i></div>
                        </div>
                    </div>

                    @* ĐÃ HOÀN THÀNH -> Tab Đã xong (2) *@
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card green" style="cursor: pointer;" @onclick='() => Nav.NavigateTo("/repairs?tab=2")'>
                            <div class="stat-body">
                                <span class="stat-label">Đã hoàn thành</span>
                                <h2 class="stat-value">@stats.Completed</h2>
                            </div>
                            <div class="stat-icon-bg"><i class="bi bi-check2-all"></i></div>
                        </div>
                    </div>

                    @* TỶ LỆ XONG *@
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card red">
                            <div class="stat-body">
                                <span class="stat-label">Tỷ lệ xong</span>
                                <h2 class="stat-value">@stats.CompletionRate%</h2>
                            </div>
                            <div class="stat-icon-bg"><i class="bi bi-lightning-charge"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @* --- 3. CHÀO MỪNG USER --- *@
    <AuthorizeView Roles="User">
        <Authorized>
            <div class="alert alert-light border-start border-primary border-4 shadow-sm mb-4 p-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-emoji-smile fs-1 text-primary me-3"></i>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Xin chào, đồng chí!</h4>
                        <p class="mb-0 text-muted">Chúc đồng chí một ngày làm việc hiệu quả. Nếu thiết bị gặp sự cố, vui lòng chọn mục <b>"Sửa Chữa"</b> ở menu bên trái để báo hỏng.</p>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @* --- 4. GIỚI THIỆU & LÃNH ĐẠO --- *@
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
