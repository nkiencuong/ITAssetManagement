                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- 5. LIÊN HỆ --- *@
    <div class="contact-section mt-5">
        <div class="text-center mb-4">
            <h5 class="fw-bold text-uppercase text-primary">Thông Tin Liên Hệ</h5>
            <div class="title-underline mx-auto"></div>
        </div>
        <div class="contact-card-white">
            <div class="row text-center gy-4">
                <div class="col-md-4">
                    <div class="contact-item">
                        <div class="icon-circle-lg bg-red-light text-danger mx-auto mb-3"><i class="bi bi-geo-alt-fill"></i></div>
                        <h6 class="fw-bold mb-1 text-dark">ĐỊA CHỈ</h6>
                        <p class="text-secondary small mb-0">Tầng 5 - Nhà A<br>Bệnh viện Đa khoa Hải Dương</p>
                    </div>
                </div>
                <div class="col-md-4 border-start-md">
                    <div class="contact-item">
                        <div class="icon-circle-lg bg-green-light text-success mx-auto mb-3"><i class="bi bi-telephone-fill"></i></div>
                        <h6 class="fw-bold mb-1 text-dark">ĐIỆN THOẠI</h6>
                        <a href="tel:02203891816" class="contact-link-dark">0220.3891.816</a>
                    </div>
                </div>
                <div class="col-md-4 border-start-md">
                    <div class="contact-item">
                        <div class="icon-circle-lg bg-blue-light text-primary mx-auto mb-3"><i class="bi bi-envelope-fill"></i></div>
                        <h6 class="fw-bold mb-1 text-dark">EMAIL</h6>
                        <a href="mailto:dungithd@gmail.com" class="contact-link-dark">dungithd@gmail.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- FOOTER --- *@
    <div class="dashboard-footer text-center mt-5 pt-4 pb-4 border-top">
        <div class="mb-2">
            <span class="fw-bold text-primary">HỆ THỐNG QUẢN LÝ TÀI SẢN CNTT</span>
            <span class="mx-2 text-muted">|</span>
            <span class="text-secondary">Version 1.0.4</span>
        </div>
        <div class="small text-muted">
            &copy; 2026 Phát triển bởi <span class="fw-bold text-dark">Phòng CNTT - Bệnh viện Đa khoa Hải Dương</span>.
        </div>
        <div class="small text-muted fst-italic mt-1">
            Hỗ trợ kỹ thuật: <b>0220.3891.816</b> (24/7)
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    private DateTime startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime endDate = DateTime.Now;
    private DashboardStatsResponse stats = new DashboardStatsResponse();

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        var user = authState.User;
        if (user.Identity.IsAuthenticated && (user.IsInRole("Admin") || user.IsInRole("SuperAdmin")))
        {
            await LoadStats();
        }
    }

    private async Task LoadStats()
    {
        try
        {
            string from = startDate.ToString("yyyy-MM-dd");
            string to = endDate.ToString("yyyy-MM-dd");
            var result = await Http.GetFromJsonAsync<DashboardStatsResponse>($"api/dashboard/stats?fromDate={from}&toDate={to}");
            if (result != null) stats = result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi load Dashboard: {ex.Message}");
        }
    }
}

<style>
    /* CSS ĐÃ ĐƯỢC FORMAT GỌN GÀNG */
    .dashboard-container {
