@page "/assets"
@using ITAssetManagement.Client.Models
@using ITAssetManagement.Client.Pages
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Quản lý Tài sản - Phòng CNTT</PageTitle>

@* ==========================================
   PHẦN 1: HEADER & BỘ LỌC (FILTER)
   ========================================== *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-primary fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>Kho Tài sản</h3>
        <small class="text-muted">Quản lý nhập xuất & tồn kho</small>
    </div>

    <div class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label fw-bold small text-muted mb-0">Từ ngày:</label>
            <div class="position-relative" style="width: 140px;">
                <input type="text" class="form-control bg-white pe-4" value="@fromDate.ToString("dd/MM/yyyy")" readonly />
                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-2 text-secondary"></i>
                <input type="date" class="form-control position-absolute top-0 start-0 w-100 h-100"
                       style="opacity: 0; cursor: pointer;"
                       @bind="fromDate" @bind:format="yyyy-MM-dd" />
            </div>
        </div>

        <div>
            <label class="form-label fw-bold small text-muted mb-0">Đến ngày:</label>
            <div class="position-relative" style="width: 140px;">
                <input type="text" class="form-control bg-white pe-4" value="@toDate.ToString("dd/MM/yyyy")" readonly />
                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-2 text-secondary"></i>
                <input type="date" class="form-control position-absolute top-0 start-0 w-100 h-100"
                       style="opacity: 0; cursor: pointer;"
                       @bind="toDate" @bind:format="yyyy-MM-dd" />
            </div>
        </div>

        <div>
            <label class="form-label fw-bold small text-muted mb-0">Nhóm TS:</label>
            <select class="form-select border-start-0" style="max-width: 220px;" value="@selectedCategory" @onchange="FilterCategory">
                <option value="">-- Tất cả tài sản --</option>
                <optgroup label="1. MÁY MÓC (CCDC)">
                    @foreach (var t in assetTypes.Where(x => x.GroupType == 1))
                    {
                        <option value="@t.Name">@t.Name</option>
                    }
                </optgroup>
                <optgroup label="2. LINH KIỆN & VẬT TƯ">
                    @foreach (var t in assetTypes.Where(x => x.GroupType == 2))
                    {
                        <option value="@t.Name">@t.Name</option>
                    }
                </optgroup>
            </select>
        </div>

        <div>
            <label class="form-label fw-bold small text-muted mb-0">Tìm kiếm:</label>
            <div class="input-group shadow-sm" style="max-width: 250px;">
                <input type="text" class="form-control border-primary"
                       placeholder="Mã, Tên, Model..."
                       @bind="searchKeyword" @bind:event="oninput" @onkeyup="ApplyFilters" />
            </div>
        </div>

        <button class="btn btn-primary shadow-sm" @onclick="LoadData" title="Lọc theo ngày">
            <i class="bi bi-search"></i>
        </button>

        <button class="btn btn-outline-secondary shadow-sm" @onclick="ShowAll" title="Xem tất cả">
            <i class="bi bi-arrow-counterclockwise"></i> Tất cả
        </button>
    </div>
</div>

<div class="mb-3 d-flex justify-content-end gap-2">
    @* 🚀 Nút Xuất kho luôn hiển thị, nhưng sẽ bị Mờ (disabled) nếu chưa chọn cái nào *@
    <button class="btn btn-warning shadow-sm fw-bold"
            disabled="@(selectedAssetIds.Count == 0)"
            @onclick="OpenAllocateModal">
        <i class="bi bi-arrow-right-circle-fill me-2"></i> Xuất kho
        @if (selectedAssetIds.Count > 0)
        {
            <span>(@selectedAssetIds.Count)</span>
        }
    </button>

    <button class="btn btn-primary shadow-sm fw-bold" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-2"></i> Nhập kho mới
    </button>
</div>

@* ==========================================
   PHẦN 2: BẢNG DỮ LIỆU
   ========================================== *@
@if (assets == null)
{
    <div class="text-center my-5 py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 fw-bold text-muted">Đang tải dữ liệu...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">
                            <input type="checkbox" class="form-check-input shadow-sm" @onchange="ToggleSelectAll" />
                        </th>
                        <th class="py-3">Mã & Tên</th>
                        <th class="py-3">Loại & Hãng</th>
                        <th class="py-3 text-center">Tồn kho</th>
                        <th class="py-3 text-center text-warning">Đã xuất</th>
                        <th class="py-3">Model</th>
                        <th class="text-end py-3">Đơn giá</th>
                        <th class="text-center py-3">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in pagedAssets)
                    {
                        var canSelect = item.Quantity > 0;
                        <tr class="@(selectedAssetIds.Contains(item.AssetID) ? "table-primary bg-opacity-10" : "")">
                            <td class="ps-4">
                                <input type="checkbox" class="form-check-input shadow-sm"
                                       disabled="@(!canSelect)"
                                       checked="@(selectedAssetIds.Contains(item.AssetID))"
                                       @onchange="@(e => ToggleSelection(item.AssetID, e.Value))" />
                            </td>
                            <td>
                                <div class="fw-bold text-primary">TS-@item.AssetID</div>
                                <div class="fw-bold text-dark mb-1">@item.AssetName</div>
                                @* 🚀 HIỆN THÊM NĂM NHẬP VÀ GIÁ ĐỂ CHỌN LÔ CHO CHUẨN *@
                                <div class="small">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary me-1">
                                        Lô: @item.ImportDate.Year
                                    </span>
                                    <span class="text-danger fw-bold">
                                        @string.Format("{0:N0}", item.Price)đ
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="badge bg-info text-dark bg-opacity-10 border border-info mb-1">@item.AssetTypeName</div>
                                <div class="small text-muted">@item.SupplierName</div>
                            </td>
                            <td class="text-center">
                                @if (item.Quantity > 0) {
                                    <span class="badge bg-success fs-6">@item.Quantity @item.Unit</span>
                                } else {
                                    <span class="badge bg-danger">Hết</span>
                                }
                            </td>
                            <td class="text-center fw-bold text-warning fs-6">
                                @item.AllocatedQuantity
                            </td>
                            <td>@item.Model</td>
                            <td class="text-end fw-bold text-secondary">@string.Format("{0:N0}", item.Price)</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info border-0 rounded-circle me-1" @onclick="() => OpenDetailModal(item.AssetID)"><i class="bi bi-eye-fill"></i></button>
                                <button class="btn btn-sm btn-outline-primary border-0 rounded-circle me-1" @onclick="() => OpenEditModal(item.AssetID)"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => DeleteAsset(item)"><i class="bi bi-trash-fill"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (assets.Any()) {
            <div class="card-footer bg-white border-0 py-3">
                <Pagination CurrentPage="@currentPage" TotalItems="@assets.Length" PageSize="@pageSize" OnPageChanged="ChangePage" />
            </div>
        }
    </div>
}

@* ==========================================
   PHẦN 3: CÁC MODAL
   ========================================== *@

@* 1. MODAL NHẬP KHO - NHẬP TỰ DO NHƯ BÌNH THƯỜNG *@
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Phiếu Nhập Kho Mới</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">Tên hàng hóa <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="newAssetRequest.AssetName" placeholder="Tên thiết bị hoặc linh kiện..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Ngày nhập</label>
                            <input type="date" class="form-control" @bind="newAssetRequest.ImportDate" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-danger">Loại tài sản <span class="text-danger">*</span></label>
                            <select class="form-select border-danger" @onchange="OnCreateTypeChanged">
                                <option value="">-- CHỌN LOẠI TÀI SẢN --</option>
                                <optgroup label="1. MÁY MÓC (CCDC)">
                                    @foreach (var t in assetTypes.Where(x => x.GroupType == 1)) {
                                        <option value="@t.Name">@t.Name</option>
                                    }
                                </optgroup>
                                <optgroup label="2. LINH KIỆN & VẬT TƯ">
                                    @foreach (var t in assetTypes.Where(x => x.GroupType == 2)) {
                                        <option value="@t.Name">@t.Name</option>
                                    }
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Hãng / Nhà cung cấp</label>
                            <input type="text" class="form-control" @bind="newAssetRequest.SupplierName" list="supplierSuggestions" placeholder="Chọn hoặc nhập mới..." />
                            <datalist id="supplierSuggestions">
                                @foreach (var name in existingSupplierNames) { <option value="@name" /> }
                            </datalist>
                        </div>
                        <div class="col-md-4"><label class="form-label fw-bold small">Số lượng</label><input type="number" class="form-control" @bind="newAssetRequest.Quantity" /></div>
                        <div class="col-md-4"><label class="form-label fw-bold small">Đơn vị</label><input type="text" class="form-control" @bind="newAssetRequest.Unit" placeholder="Cái, Bộ, Lọ..." /></div>
                        <div class="col-md-4"><label class="form-label fw-bold small">Đơn giá</label><input type="number" class="form-control" @bind="newAssetRequest.Price" /></div>
                        <div class="col-12"><label class="form-label fw-bold small">Model / Thông số kỹ thuật</label><input type="text" class="form-control" @bind="newAssetRequest.Model" placeholder="Nhập đời máy hoặc thông số linh kiện..." /></div>
                        <div class="col-12"><label class="form-label fw-bold small">Vị trí lưu kho</label><input type="text" class="form-control" @bind="newAssetRequest.Location" /></div>
                        <div class="col-12"><label class="form-label fw-bold small">Ghi chú thêm</label><textarea class="form-control" rows="2" @bind="newAssetRequest.Config"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button class="btn btn-light border" @onclick="CloseCreateModal">Hủy bỏ</button>
                    <button class="btn btn-primary fw-bold px-4" @onclick="SaveAsset">Lưu phiếu nhập</button>
                </div>
            </div>
        </div>
    </div>
}

@* 2. MODAL XUẤT KHO *@
@if (showAllocateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">Xuất kho / Cấp phát</h5>
                    <button type="button" class="btn-close" @onclick="CloseAllocateModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-warning mb-3">Đang chọn <strong>@selectedAssetIds.Count</strong> mã hàng.</div>
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="fw-bold">Số lượng xuất:</label><input type="number" class="form-control" @bind="allocationRequest.Quantity" min="1" /></div>
                        <div class="col-md-6 mb-3"><label class="fw-bold">Ngày xuất:</label><input type="date" class="form-control" @bind="allocationRequest.AllocatedDate" @bind:format="yyyy-MM-dd" /></div>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Khoa / Phòng nhận:</label>
                        <select class="form-select" @bind="allocationRequest.DepartmentID">
                            <option value="0">-- Chọn phòng --</option>
                            @if (departments != null) {
                                foreach (var d in departments) { <option value="@d.DepartmentID">@d.DeptName</option> }
                            }
                        </select>
                    </div>
                    <div class="mb-3"><label class="fw-bold">Ghi chú:</label><textarea class="form-control" @bind="allocationRequest.Note"></textarea></div>
                </div>
                <div class="modal-footer"><button class="btn btn-warning fw-bold" @onclick="SubmitAllocation">Xác nhận xuất</button></div>
            </div>
        </div>
    </div>
}

@* 3. MODAL SỬA *@
@if (showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title fw-bold">Cập nhật Tài sản</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12"><label class="fw-bold small">Tên tài sản:</label><input class="form-control" @bind="editingAsset.AssetName" /></div>
                        @* 🚀 ĐÃ CHIA LẠI THÀNH 3 CỘT (LOẠI - HÃNG - NGÀY NHẬP) *@
                        <div class="col-md-4">
                            <label class="fw-bold small">Loại:</label>
                            <select class="form-select" @bind="editingAsset.AssetTypeID">
                                @foreach (var t in assetTypes)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="fw-bold small">Hãng:</label>
                            <input class="form-control" @bind="editingAsset.SupplierName" />
                        </div>
                        <div class="col-md-4">
                            <label class="fw-bold small text-danger">Ngày nhập:</label>
                            <input type="date" class="form-control border-danger" @bind="editingAsset.ImportDate" @bind:format="yyyy-MM-dd" />
                        </div>

                    @* 🚀 ĐÃ SỬA TỪ col-md-4 THÀNH col-md-3 ĐỂ NHÉT VỪA 4 Ô *@
                    <div class="col-md-3"><label class="fw-bold small">Model:</label><input class="form-control" @bind="editingAsset.Model" /></div>
                    <div class="col-md-3"><label class="fw-bold small">Số lượng:</label><input type="number" class="form-control" @bind="editingAsset.Quantity" /></div>

                    @* 🚀🚀🚀 MỚI THÊM: Ô ĐƠN VỊ *@
                    <div class="col-md-3"><label class="fw-bold small">Đơn vị:</label><input class="form-control" @bind="editingAsset.Unit" placeholder="Chiếc, Hộp..." /></div>

                    <div class="col-md-3"><label class="fw-bold small">Giá:</label><input type="number" class="form-control" @bind="editingAsset.Price" /></div>
                    @* =========================== *@

                    <div class="col-12"><label class="fw-bold small">Ghi chú:</label><textarea class="form-control" @bind="editingAsset.Config"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer"><button class="btn btn-primary" @onclick="SubmitUpdate">Lưu thay đổi</button></div>
            </div>
        </div>
    </div>
}

@* 4. MODAL CHI TIẾT ĐẸP *@
@if (showDetailModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg overflow-hidden">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Chi tiết Tài sản</h5>
                    <button class="btn-close btn-close-white" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-4 bg-light border-bottom">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="text-dark fw-bold mb-1">@editingAsset.AssetName</h4>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-primary">Mã: TS-@editingAsset.AssetID</span>
                                    <span class="badge bg-info text-dark">@editingAsset.AssetTypeName</span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <div class="text-muted small">Tồn kho:</div>
                                <h3 class="@(editingAsset.Quantity > 0 ? "text-success" : "text-danger") fw-bold mb-0">@editingAsset.Quantity <small class="fs-6">@editingAsset.Unit</small></h3>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="mb-3"><label class="text-muted small text-uppercase fw-bold">Hãng / Nhà cung cấp</label><div class="fw-bold"><i class="bi bi-building me-2 text-secondary"></i>@editingAsset.SupplierName</div></div>
                                <div class="mb-3"><label class="text-muted small text-uppercase fw-bold">Model / Thông số</label><div class="fw-bold"><i class="bi bi-cpu me-2 text-secondary"></i>@editingAsset.Model</div></div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3"><label class="text-muted small text-uppercase fw-bold">Giá trị nhập</label><div class="fw-bold text-primary fs-5">@string.Format("{0:N0} VNĐ", editingAsset.Price)</div></div>
                                <div class="mb-3"><label class="text-muted small text-uppercase fw-bold">Vị trí & Ngày nhập</label><div class="fw-bold text-dark"><i class="bi bi-geo-alt me-2 text-secondary"></i>@editingAsset.Location | @editingAsset.ImportDate.ToString("dd/MM/yyyy")</div></div>
                            </div>
                            <div class="col-12"><label class="text-muted small text-uppercase fw-bold">Cấu hình & Ghi chú</label><div class="p-3 bg-white border rounded shadow-sm" style="min-height: 80px; white-space: pre-wrap;">@editingAsset.Config</div></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-3"><button class="btn btn-secondary px-4 fw-bold" @onclick="() => showDetailModal = false">Đóng</button></div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime fromDate = DateTime.Now.AddDays(-30);
    private DateTime toDate = DateTime.Now;
    private string selectedCategory = "";
    private string searchKeyword = "";
    private Asset[]? allAssets;
    private Asset[]? assets;
    private DepartmentDTO[]? departments;
    private HashSet<int> selectedAssetIds = new HashSet<int>();
    private Asset[] pagedAssets = Array.Empty<Asset>();
    private int currentPage = 1;
    private int pageSize = 15;
    private bool showCreateModal = false;
    private bool showAllocateModal = false;
    private bool showEditModal = false;
    private bool showDetailModal = false;
    private CreateAssetRequest newAssetRequest = new CreateAssetRequest();
    private AllocateRequest allocationRequest = new AllocateRequest();
    private Asset editingAsset = new Asset();
    private List<string> existingSupplierNames = new();

    private List<AssetTypeOption> assetTypes = new() {
        new AssetTypeOption { Id = 1, Name = "Máy tính", GroupType = 1 },
        new AssetTypeOption { Id = 2, Name = "Máy in", GroupType = 1 },
        new AssetTypeOption { Id = 3, Name = "Máy Scan", GroupType = 1 },
        new AssetTypeOption { Id = 4, Name = "Các loại khác", GroupType = 1 },
        new AssetTypeOption { Id = 5, Name = "LK Máy in", GroupType = 2 },
        new AssetTypeOption { Id = 6, Name = "LK Máy tính", GroupType = 2 },
        new AssetTypeOption { Id = 7, Name = "Thiết bị mạng", GroupType = 2 },
        new AssetTypeOption { Id = 8, Name = "Thiết bị âm thanh", GroupType = 2 },
        new AssetTypeOption { Id = 9, Name = "Camera", GroupType = 2 },
        new AssetTypeOption { Id = 10, Name = "Thiết bị khác", GroupType = 2 }
    };

    public class AssetTypeOption { public int Id { get; set; } public string Name { get; set; } public int GroupType { get; set; } }

    protected override async Task OnInitializedAsync() { await LoadData(); await LoadDepartments(); }

    private async Task LoadData() {
        try {
            string fDate = fromDate.ToString("yyyy-MM-dd");
            string tDate = toDate.ToString("yyyy-MM-dd");
            allAssets = await Http.GetFromJsonAsync<Asset[]>($"api/admin/assets?from={fDate}&to={tDate}");
            if (allAssets != null) {
                existingSupplierNames = allAssets.Where(x => !string.IsNullOrEmpty(x.SupplierName)).Select(x => x.SupplierName!).Distinct().OrderBy(x => x).ToList();
            }
            ApplyFilters();
        } catch { }
    }

    private async Task ShowAll() { fromDate = new DateTime(2020, 1, 1); toDate = DateTime.Now; selectedCategory = ""; searchKeyword = ""; await LoadData(); }

    private async Task LoadDepartments() { try { departments = await Http.GetFromJsonAsync<DepartmentDTO[]>("api/admin/departments"); } catch { } }

    private void FilterCategory(ChangeEventArgs? e) { if (e != null) selectedCategory = e.Value?.ToString() ?? ""; ApplyFilters(); }

    private void ApplyFilters() {
        if (allAssets == null) return;
        IEnumerable<Asset> query = allAssets;
        if (!string.IsNullOrEmpty(selectedCategory)) query = query.Where(x => (x.AssetTypeName ?? "").Trim().Equals(selectedCategory.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(searchKeyword)) {
            var kw = searchKeyword.Trim().ToLower();
            query = query.Where(x => (x.AssetName ?? "").ToLower().Contains(kw) || ($"TS-{x.AssetID}").ToLower().Contains(kw) || (x.Model ?? "").ToLower().Contains(kw));
        }
        assets = query.ToArray();
        currentPage = 1;
        UpdatePagedList();
    }

    private void UpdatePagedList() { if (assets != null) pagedAssets = assets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToArray(); }

    private void ChangePage(int page) { currentPage = page; UpdatePagedList(); }

    private void ToggleSelection(int id, object check) { if ((bool)check) selectedAssetIds.Add(id); else selectedAssetIds.Remove(id); }

    private void ToggleSelectAll(ChangeEventArgs e) {
        if ((bool)e.Value && assets != null) foreach (var a in assets.Where(x => x.Quantity > 0)) selectedAssetIds.Add(a.AssetID);
        else selectedAssetIds.Clear();
    }

    private void OpenCreateModal() { newAssetRequest = new CreateAssetRequest { Quantity = 1, Unit = "Cái", AssetTypeName = "", SupplierName = "Kho Tổng", ImportDate = DateTime.Now }; showCreateModal = true; }

    private void CloseCreateModal() => showCreateModal = false;

    private void OnCreateTypeChanged(ChangeEventArgs e) { newAssetRequest.AssetTypeName = e.Value?.ToString() ?? ""; }

    private async Task SaveAsset()
    {
        if (string.IsNullOrEmpty(newAssetRequest.AssetTypeName)) { await JS.InvokeVoidAsync("alert", "Vui lòng chọn Loại tài sản!"); return; }
        if (string.IsNullOrEmpty(newAssetRequest.AssetName)) { await JS.InvokeVoidAsync("alert", "Vui lòng nhập Tên hàng hóa!"); return; }

        var res = await Http.PostAsJsonAsync("api/assets", newAssetRequest);
        if (res.IsSuccessStatusCode)
        {
            showCreateModal = false;   // 1. Tắt popup
            await LoadData();          // 2. Lấy dữ liệu mới luôn
            StateHasChanged();         // 3. Ra lệnh vẽ lại màn hình

            // 🚀 PHÉP MÀU NẰM Ở ĐÂY: Cho hệ thống nghỉ 0.1 giây để vẽ xong giao diện
            await Task.Delay(100);

            // 4. Mọi thứ đã xong xuôi mới hiện thông báo
            await JS.InvokeVoidAsync("alert", "Nhập kho thành công!");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Lỗi: Không thể lưu vào hệ thống!");
        }
    }

    private void OpenAllocateModal() { allocationRequest = new AllocateRequest { AllocatedDate = DateTime.Now, Quantity = 1 }; showAllocateModal = true; }
    private void CloseAllocateModal() => showAllocateModal = false;

    private async Task SubmitAllocation() {
        if (allocationRequest.DepartmentID == 0) { await JS.InvokeVoidAsync("alert", "Chọn Phòng ban!"); return; }
        allocationRequest.AssetIds = selectedAssetIds.ToList();
        var res = await Http.PostAsJsonAsync("api/allocations", allocationRequest);
        if (res.IsSuccessStatusCode) { showAllocateModal = false; selectedAssetIds.Clear(); await LoadData(); await JS.InvokeVoidAsync("alert", "Xuất thành công!"); }
    }

    private async Task OpenEditModal(int id) { editingAsset = await Http.GetFromJsonAsync<Asset>($"api/admin/assets/{id}"); showEditModal = true; }
    private void OnEditTypeChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int id)) editingAsset.AssetTypeID = id; }

    private async Task SubmitUpdate()
    {
        var res = await Http.PutAsJsonAsync($"api/assets/{editingAsset.AssetID}", editingAsset);
        if (res.IsSuccessStatusCode)
        {
            showEditModal = false;     // 1. Tắt popup
            await LoadData();          // 2. Cập nhật bảng dữ liệu
            StateHasChanged();         // 3. Ra lệnh vẽ lại màn hình

            // 🚀 BẮT BUỘC PHẢI CÓ DÒNG NÀY ĐỂ TRÁNH ĐÓNG BĂNG GIAO DIỆN
            await Task.Delay(100);

            // 4. Hiện thông báo
            await JS.InvokeVoidAsync("alert", "Cập nhật thành công!");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Lỗi: Không thể cập nhật!");
        }
    }

  private async Task OpenDetailModal(int id)
    {
        // 1. Lấy dữ liệu chi tiết của tài sản từ API
        var result = await Http.GetFromJsonAsync<Asset>($"api/admin/assets/{id}");
        
        if (result != null)
        {
            editingAsset = result;

            // 🚀 CÂU CHỐT HẠ ĐỂ HIỆN TÊN HÃNG:
            // Nếu SupplierName bị trống (thường do API chỉ trả về ID), 
            // ta lấy tạm tên từ danh sách hiển thị ngoài bảng để gán vào.
            if (string.IsNullOrEmpty(editingAsset.SupplierName))
            {
                var assetInList = assets?.FirstOrDefault(x => x.AssetID == id);
                editingAsset.SupplierName = assetInList?.SupplierName ?? "Chưa xác định";
            }

            showDetailModal = true;
        }
    }

    private async Task DeleteAsset(Asset item) {
        if (await JS.InvokeAsync<bool>("confirm", $"Xóa '{item.AssetName}'?")) {
            var res = await Http.DeleteAsync($"api/assets/{item.AssetID}");
            if (res.IsSuccessStatusCode) { await LoadData(); await JS.InvokeVoidAsync("alert", "Đã xóa!"); }
        }
    }

