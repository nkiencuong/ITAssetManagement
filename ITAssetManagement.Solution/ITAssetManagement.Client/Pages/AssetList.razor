@page "/assets"
@using ITAssetManagement.Client.Models
@using ITAssetManagement.Client.Pages
@* 👆 Nhớ dòng này để dùng Pagination *@
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Quản lý Tài sản - Phòng CNTT</PageTitle>

@* --- HEADER --- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-primary fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>Kho Tài sản</h3>
        <small class="text-muted">Quản lý nhập xuất & tồn kho (Auto-Create)</small>
    </div>

    <div class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white text-primary"><i class="bi bi-calendar3"></i></span>
            <input type="date" class="form-control" @onchange="FilterByDate" />

            <select class="form-select border-start-0" style="max-width: 180px;" @onchange="FilterCategory">
                <option value="">-- Tất cả tài sản --</option>
                <option value="PART">🔧 Linh kiện & Vật tư</option>
                <option value="Máy in">🖨️ Máy in</option>
                <option value="Máy Scan">📠 Máy Scan</option>
                <option value="Máy tính">💻 Máy tính / Laptop</option>
                <option value="Thiết bị mạng">🌐 Thiết bị mạng</option>
                <option value="Thiết bị âm thanh">🔊 Thiết bị âm thanh</option>
                <option value="Camera">📷 Camera</option>
            </select>
            <button class="btn btn-outline-secondary" @onclick="ReloadOriginalData" title="Xem tất cả">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        @if (selectedAssetIds.Count > 0)
        {
            <button class="btn btn-warning shadow-sm fw-bold" @onclick="OpenAllocateModal">
                <i class="bi bi-arrow-right-circle-fill me-2"></i>Xuất kho (@selectedAssetIds.Count)
            </button>
        }
        <button class="btn btn-primary shadow-sm fw-bold" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-2"></i> Nhập kho mới
        </button>
    </div>
</div>

@* --- DANH SÁCH TÀI SẢN --- *@
@if (assets == null)
{
    <div class="text-center my-5 py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 fw-bold text-muted">Đang tải dữ liệu...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4 py-3" style="width: 50px;">
                            <input type="checkbox" class="form-check-input shadow-sm" @onchange="ToggleSelectAll" />
                        </th>
                        <th class="py-3">Mã & Tên</th>
                        <th class="py-3">Loại & Hãng</th>
                        <th class="py-3 text-center">Tồn kho</th>
                        <th class="py-3">Model</th>
                        <th class="text-end py-3">Đơn giá</th>
                        <th class="text-center py-3">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @* 👇 QUAN TRỌNG: Duyệt qua pagedAssets thay vì assets *@
                    @foreach (var item in pagedAssets)
                    {
                        var canSelect = item.Quantity > 0;
                        <tr class="@(selectedAssetIds.Contains(item.AssetID) ? "table-primary bg-opacity-10" : "")">
                            <td class="ps-4">
                                <input type="checkbox" class="form-check-input shadow-sm"
                                       disabled="@(!canSelect)"
                                       checked="@(selectedAssetIds.Contains(item.AssetID))"
                                       @onchange="@(e => ToggleSelection(item.AssetID, e.Value))" />
                            </td>
                            <td>
                                <div class="fw-bold text-primary">TS-@item.AssetID</div>
                                <span class="fw-bold text-dark">@item.AssetName</span>
                                <div class="small text-muted fst-italic mt-1">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    @if (item.ImportDate.Year > 2000)
                                    {
                                        <span class="text-success fw-bold">@item.ImportDate.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="badge bg-info text-dark bg-opacity-10 border border-info mb-1">@item.AssetTypeName</div>
                                <div class="small text-muted"><i class="bi bi-building me-1"></i>@item.SupplierName</div>
                            </td>
                            <td class="text-center">
                                @if (item.Quantity > 0)
                                {
                                    <span class="badge bg-success fs-6">@item.Quantity @item.Unit</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </td>
                            <td>@item.Model</td>
                            <td class="text-end fw-bold text-secondary">@string.Format("{0:N0}", item.Price)</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info border-0 rounded-circle me-1" @onclick="() => OpenDetailModal(item.AssetID)"><i class="bi bi-eye-fill"></i></button>
                                <button class="btn btn-sm btn-outline-primary border-0 rounded-circle me-1" @onclick="() => OpenEditModal(item.AssetID)"><i class="bi bi-pencil-fill"></i></button>
                                <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => DeleteAsset(item)"><i class="bi bi-trash-fill"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* 👇 THANH PHÂN TRANG 👇 *@
        @if (assets.Any())
        {
            <div class="card-footer bg-white border-0 py-3">
                <Pagination CurrentPage="@currentPage"
                            TotalItems="@assets.Length"
                            PageSize="@pageSize"
                            OnPageChanged="ChangePage" />
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-1"></i>
                <p class="mt-3 mb-0">Không tìm thấy dữ liệu phù hợp.</p>
                <button class="btn btn-link" @onclick="ReloadOriginalData">Xem tất cả</button>
            </div>
        }
    </div>
}

@* --- MODAL NHẬP KHO MỚI (CREATE) --- *@
@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Phiếu Nhập Kho</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small">Tên hàng hóa <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="newAssetRequest.AssetName" placeholder="VD: Laptop Dell Vostro 3510" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-primary">Ngày nhập (Chứng từ):</label>
                            <input type="date" class="form-control border-primary" @bind="newAssetRequest.ImportDate" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Loại tài sản</label><input type="text" class="form-control" @bind="newAssetRequest.AssetTypeName" /></div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Hãng / Nhà cung cấp</label><input type="text" class="form-control" @bind="newAssetRequest.SupplierName" /></div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Số lượng</label><input type="number" class="form-control" @bind="newAssetRequest.Quantity" /></div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Đơn vị</label>
                            <input type="text" class="form-control" @bind="newAssetRequest.Unit" list="unitList" />
                            <datalist id="unitList"><option value="Cái" /><option value="Chiếc" /><option value="Bộ" /></datalist>
                        </div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Model</label><input type="text" class="form-control" @bind="newAssetRequest.Model" /></div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Đơn giá</label><input type="number" class="form-control" @bind="newAssetRequest.Price" /></div>
                        <div class="col-12"><label class="form-label fw-bold small">Vị trí</label><input type="text" class="form-control" @bind="newAssetRequest.Location" /></div>
                        <div class="col-12"><label class="form-label fw-bold small">Cấu hình / Ghi chú</label><textarea class="form-control" rows="2" @bind="newAssetRequest.Config"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button class="btn btn-light border" @onclick="CloseCreateModal">Hủy bỏ</button>
                    <button class="btn btn-primary fw-bold" @onclick="SaveAsset">Lưu phiếu nhập</button>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL XUẤT KHO / CẤP PHÁT (ALLOCATE) --- *@
@if (showAllocateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold">Xuất kho / Cấp phát</h5>
                    <button type="button" class="btn-close" @onclick="CloseAllocateModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-warning mb-3">
                        Đang chọn xuất <strong>@selectedAssetIds.Count</strong> mã hàng.
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số lượng (Mỗi mã):</label>
                            <input type="number" class="form-control border-warning fw-bold text-center"
                                   @bind="allocationRequest.Quantity" min="1" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-primary">Ngày xuất kho:</label>
                            <input type="date" class="form-control border-warning"
                                   @bind="allocationRequest.AllocatedDate" @bind:format="yyyy-MM-dd" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Khoa / Phòng nhận:</label>
                        <select class="form-select" @bind="allocationRequest.DepartmentID">
                            <option value="0">-- Chọn phòng ban --</option>
                            @if (departments != null)
                            {
                                foreach (var dept in departments)
                                {
                                    <option value="@dept.DepartmentID">@dept.DeptName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú:</label>
                        <textarea class="form-control" @bind="allocationRequest.Note" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button class="btn btn-light border" @onclick="CloseAllocateModal">Hủy</button>
                    <button class="btn btn-warning fw-bold" @onclick="SubmitAllocation">Xác nhận Xuất</button>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL CHỈNH SỬA (EDIT) --- *@
@if (showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title fw-bold">Cập nhật Tài sản</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12"><label>Tên tài sản:</label><input class="form-control" @bind="editingAsset.AssetName" /></div>
                        <div class="col-md-6">
                            <label class="fw-bold text-primary">Loại tài sản:</label>
                            <select class="form-select" @bind="editingAsset.AssetTypeID">
                                <option value="0">-- Chọn loại --</option>
                                @foreach (var type in listAssetTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6"><label>Model:</label><input class="form-control" @bind="editingAsset.Model" /></div>
                        <div class="col-md-6"><label>Số lượng:</label><input type="number" class="form-control" @bind="editingAsset.Quantity" /></div>
                        <div class="col-md-6"><label>Giá tiền:</label><input type="number" class="form-control" @bind="editingAsset.Price" /></div>
                        <div class="col-md-6"><label>Vị trí:</label><input class="form-control" @bind="editingAsset.Location" /></div>
                        <div class="col-12"><label>Cấu hình:</label><textarea class="form-control" @bind="editingAsset.Config"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showEditModal = false">Hủy</button>
                    <button class="btn btn-primary" @onclick="SubmitUpdate">Lưu thay đổi</button>
                </div>
            </div>
        </div>
    </div>
}

@* --- MODAL CHI TIẾT (DETAIL) --- *@
@if (showDetailModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Chi tiết Tài sản</h5>
                    <button class="btn-close" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-striped">
                        <tr><td class="fw-bold">Tên:</td><td>@editingAsset.AssetName</td></tr>
                        <tr><td class="fw-bold">Loại:</td><td>@editingAsset.AssetTypeName</td></tr>
                        <tr><td class="fw-bold">Hãng:</td><td>@editingAsset.SupplierName</td></tr>
                        <tr><td class="fw-bold">Model:</td><td>@editingAsset.Model</td></tr>
                        <tr><td class="fw-bold">Số lượng:</td><td>@editingAsset.Quantity @editingAsset.Unit</td></tr>
                        <tr><td class="fw-bold">Giá:</td><td>@string.Format("{0:N0} VNĐ", editingAsset.Price)</td></tr>
                        <tr><td class="fw-bold">Vị trí:</td><td>@editingAsset.Location</td></tr>
                        <tr><td class="fw-bold">Cấu hình:</td><td>@editingAsset.Config</td></tr>
                        <tr>
                            <td class="fw-bold">Ngày chứng từ:</td>
                            <td>
                                @if (editingAsset.ImportDate.Year > 2000)
                                {
                                    <span class="text-success fw-bold">@editingAsset.ImportDate.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">@editingAsset.CreatedDate.ToString("dd/MM/yyyy")</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showDetailModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Asset[]? allAssets;
    private Asset[]? assets;
    private DepartmentDTO[]? departments;
    private HashSet<int> selectedAssetIds = new HashSet<int>();

    // 👇 KHAI BÁO BIẾN PHÂN TRANG
    private Asset[] pagedAssets = Array.Empty<Asset>();
    private int currentPage = 1;
    private int pageSize = 15; // Mỗi trang 15 dòng cho gọn

    private bool showCreateModal = false;
    private bool showAllocateModal = false;
    private bool showEditModal = false;
    private bool showDetailModal = false;

    private CreateAssetRequest newAssetRequest = new CreateAssetRequest();
    private AllocateRequest allocationRequest = new AllocateRequest();
    private Asset editingAsset = new Asset();

    private List<AssetTypeOption> listAssetTypes = new()
    {
        new AssetTypeOption { Id = 1, Name = "Laptop" },
        new AssetTypeOption { Id = 2, Name = "Máy in" },
        new AssetTypeOption { Id = 3, Name = "Máy Scan" },
        new AssetTypeOption { Id = 4, Name = "Máy tính" },
        new AssetTypeOption { Id = 5, Name = "Thiết bị chung" },
        new AssetTypeOption { Id = 6, Name = "Linh kiện" },
        new AssetTypeOption { Id = 7, Name = "Thiết bị mạng" },
        new AssetTypeOption { Id = 8, Name = "Camera" }
    };
    public class AssetTypeOption { public int Id { get; set; } public string Name { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadDepartments();
    }

    private async Task LoadData()
    {
        allAssets = await Http.GetFromJsonAsync<Asset[]>("https://localhost:7239/api/admin/assets");
        assets = allAssets;
        UpdatePagedList(); // 👈 Cập nhật phân trang ngay sau khi tải
    }

    private async Task LoadDepartments() => departments = await Http.GetFromJsonAsync<DepartmentDTO[]>("https://localhost:7239/api/admin/departments");

    private void FilterByDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime selectedDate))
        {
            if (allAssets != null)
            {
                assets = allAssets.Where(x => x.ImportDate.Date == selectedDate.Date).ToArray();
            }
        }
        else { assets = allAssets; }

        currentPage = 1; // Reset trang
        UpdatePagedList();
    }

    private void FilterCategory(ChangeEventArgs e)
    {
        string selectedType = e.Value?.ToString() ?? "";
        if (allAssets == null) return;

        if (string.IsNullOrEmpty(selectedType)) assets = allAssets;
        else if (selectedType == "PART")
            assets = allAssets.Where(x => (x.AssetTypeName ?? "").ToLower().Contains("linh kiện") || (x.AssetTypeName ?? "").ToLower().Contains("vật tư")).ToArray();
        else
            assets = allAssets.Where(x => (x.AssetTypeName ?? "").ToLower().Contains(selectedType.ToLower())).ToArray();

        currentPage = 1; // Reset trang
        UpdatePagedList();
    }

    private void ReloadOriginalData()
    {
        assets = allAssets;
        currentPage = 1;
        UpdatePagedList();
    }

    // 👇 LOGIC PHÂN TRANG
    private void UpdatePagedList()
    {
        if (assets != null)
        {
            pagedAssets = assets.Skip((currentPage - 1) * pageSize).Take(pageSize).ToArray();
        }
    }

    private void ChangePage(int page)
    {
        currentPage = page;
        UpdatePagedList();
    }

    private void ToggleSelection(int id, object check) { if ((bool)check) selectedAssetIds.Add(id); else selectedAssetIds.Remove(id); }
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)e.Value && assets != null) foreach (var a in assets.Where(x => x.Quantity > 0)) selectedAssetIds.Add(a.AssetID);
        else selectedAssetIds.Clear();
    }

    private void OpenCreateModal()
    {
        newAssetRequest = new CreateAssetRequest { Quantity = 1, Unit = "Cái", AssetTypeName = "Thiết bị chung", SupplierName = "Kho Tổng", ImportDate = DateTime.Now };
        showCreateModal = true;
    }
    private void CloseCreateModal() => showCreateModal = false;
    private async Task SaveAsset()
    {
        var res = await Http.PostAsJsonAsync("https://localhost:7239/api/assets", newAssetRequest);
        if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Nhập kho thành công!"); showCreateModal = false; await LoadData(); }
        else { var msg = await res.Content.ReadAsStringAsync(); await JS.InvokeVoidAsync("alert", "Lỗi: " + msg); }
    }

    private void OpenAllocateModal()
    {
        allocationRequest = new AllocateRequest();
        allocationRequest.AllocatedDate = DateTime.Now;
        allocationRequest.Quantity = 1;
        showAllocateModal = true;
    }
    private void CloseAllocateModal() => showAllocateModal = false;
    private async Task SubmitAllocation()
    {
        if (allocationRequest.DepartmentID == 0) { await JS.InvokeVoidAsync("alert", "Vui lòng chọn Phòng ban!"); return; }
        if (allocationRequest.Quantity <= 0) { await JS.InvokeVoidAsync("alert", "Số lượng phải lớn hơn 0!"); return; }

        allocationRequest.AssetIds = selectedAssetIds.ToList();
        var res = await Http.PostAsJsonAsync("https://localhost:7239/api/allocations", allocationRequest);
        if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Xuất kho thành công!"); showAllocateModal = false; selectedAssetIds.Clear(); await LoadData(); }
        else { await JS.InvokeVoidAsync("alert", "Lỗi cấp phát!"); }
    }

    private async Task OpenEditModal(int id) { editingAsset = await Http.GetFromJsonAsync<Asset>($"https://localhost:7239/api/admin/assets/{id}"); showEditModal = true; }
    private async Task SubmitUpdate()
    {
        var res = await Http.PutAsJsonAsync($"https://localhost:7239/api/assets/{editingAsset.AssetID}", editingAsset);
        if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Cập nhật thành công!"); showEditModal = false; await LoadData(); } else { await JS.InvokeVoidAsync("alert", "Cập nhật thất bại!"); }
    }
    private async Task OpenDetailModal(int id) { editingAsset = await Http.GetFromJsonAsync<Asset>($"https://localhost:7239/api/admin/assets/{id}"); showDetailModal = true; }
    private async Task DeleteAsset(Asset item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa '{item.AssetName}' không?")) { var res = await Http.DeleteAsync($"https://localhost:7239/api/assets/{item.AssetID}"); if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Đã xóa thành công!"); await LoadData(); } else { var msg = await res.Content.ReadAsStringAsync(); await JS.InvokeVoidAsync("alert", "Lỗi: " + msg); } }
    }

    // CLASSES
    public class DepartmentDTO { public int DepartmentID { get; set; } public string DeptName { get; set; } }
    public class AllocateRequest
    {
        public List<int> AssetIds { get; set; }
        public int DepartmentID { get; set; }
        public int? UserID { get; set; }
        public DateTime AllocatedDate { get; set; }
        public string? Note { get; set; }
        public int Quantity { get; set; } = 1;
    }
    public class CreateAssetRequest { public string AssetName { get; set; } = ""; public int Quantity { get; set; } = 1; public string Unit { get; set; } = "Cái"; public string? Model { get; set; } public decimal Price { get; set; } public string? Config { get; set; } public string? Location { get; set; } public string AssetTypeName { get; set; } = ""; public string SupplierName { get; set; } = ""; public DateTime ImportDate { get; set; } = DateTime.Now; }

    public class Asset
    {
        public int AssetID { get; set; }
        public string AssetName { get; set; }
        public int Quantity { get; set; }
        public string Unit { get; set; }
        public string? Model { get; set; }
        public int AssetTypeID { get; set; }
        public int? SupplierID { get; set; }
        public int? DepartmentID { get; set; }
        public int Status { get; set; }
        public DateTime CreatedDate { get; set; }
        public DateTime ImportDate { get; set; }
