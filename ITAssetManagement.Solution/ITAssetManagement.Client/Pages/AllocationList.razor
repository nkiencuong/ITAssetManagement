@page "/allocations"
@using ITAssetManagement.Client.Models
@using ITAssetManagement.Client.Pages
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Quản lý Cấp phát</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-primary fw-bold mb-0"><i class="bi bi-box-arrow-right me-2"></i>Cấp phát & Thu hồi</h3>
        <small class="text-muted">Quản lý lịch sử bàn giao thiết bị cho nhân viên/phòng ban</small>
    </div>

    <div class="d-flex gap-2 align-items-end">
        @* --- Ô TỪ NGÀY (CÓ ICON LỊCH) --- *@
        <div>
            <label class="form-label fw-bold small text-muted mb-0">Từ ngày:</label>
            <div class="position-relative" style="width: 140px;">
                @* 1. Ô hiển thị Text (dd/MM/yyyy) *@
                <input type="text" class="form-control bg-white pe-4" value="@fromDate.ToString("dd/MM/yyyy")" readonly />

                @* 2. Icon Lịch *@
                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-2 text-secondary"></i>

                @* 3. Ô Date thật (Ẩn) *@
                <input type="date" class="form-control position-absolute top-0 start-0 w-100 h-100"
                       style="opacity: 0; cursor: pointer;"
                       @bind="fromDate" @bind:format="yyyy-MM-dd" />
            </div>
        </div>

        @* --- Ô ĐẾN NGÀY (CÓ ICON LỊCH) --- *@
        <div>
            <label class="form-label fw-bold small text-muted mb-0">Đến ngày:</label>
            <div class="position-relative" style="width: 140px;">
                <input type="text" class="form-control bg-white pe-4" value="@toDate.ToString("dd/MM/yyyy")" readonly />
                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-2 text-secondary"></i>
                <input type="date" class="form-control position-absolute top-0 start-0 w-100 h-100"
                       style="opacity: 0; cursor: pointer;"
                       @bind="toDate" @bind:format="yyyy-MM-dd" />
            </div>
        </div>

        @* Nút Lọc *@
        <button class="btn btn-primary fw-bold shadow-sm" @onclick="LoadData" title="Xem theo ngày">
            <i class="bi bi-search"></i>
        </button>

        @* Nút Tất cả *@
        <button class="btn btn-outline-secondary fw-bold shadow-sm" @onclick="ShowAll" title="Xem tất cả lịch sử">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Tất cả
        </button>
    </div>
</div>

@* --- PHẦN DANH SÁCH (GIỮ NGUYÊN) --- *@
@if (allocations == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (allocations.Count == 0)
{
    <div class="text-center my-5 py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">Không có dữ liệu cấp phát trong khoảng thời gian này.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tài sản</th>
                    <th>Chi tiết</th>
                    <th>Phòng ban / Người nhận</th>
                    <th>Ngày cấp</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedAllocations)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.AssetName</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Serial))
                            {
                                <span>SN: @item.Serial</span>
                            }
                            else
                            {

                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="fw-bold">@item.DepartmentName</div>
                            <small class="text-muted">👤 @(item.ReceiverName ?? "Chưa xác định")</small>
                        </td>
                        <td>@item.AllocatedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == 1)
                            {
                                <span class="badge bg-success">Đang dùng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã trả</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Status == 1)
                            {
                                <button class="btn btn-warning btn-sm fw-bold" @onclick="() => OpenModal(item)">
                                    <i class="bi bi-arrow-return-left me-1"></i> Thu hồi
                                </button>
                            }
                            else
                            {
                                <span class="text-success"><i class="bi bi-check-circle"></i> Xong</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (allocations.Count > 0)
    {
        <div class="mt-3">
            <Pagination CurrentPage="@currentPage" TotalItems="@allocations.Count" PageSize="@pageSize" OnPageChanged="ChangePage" />
        </div>
    }
}

@* --- MODAL THU HỒI (GIỮ NGUYÊN) --- *@
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title fw-bold">Xác nhận Thu hồi</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        Đang thu hồi: <strong>@selectedItem?.AssetName</strong><br />
                        Từ: <strong>@selectedItem?.DepartmentName</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-danger">Ngày thu hồi:</label>
                        <input type="date" class="form-control" @bind="returnRequest.ReturnDate" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do thu hồi / Tình trạng:</label>
                        <textarea class="form-control" @bind="returnRequest.Note" rows="3" placeholder="Ví dụ: Hỏng main, Nhân viên nghỉ việc..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitReturn">✅ Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime fromDate = DateTime.Now.AddDays(-30);
    private DateTime toDate = DateTime.Now;

    private List<Allocation>? allocations;
    private List<Allocation> pagedAllocations = new();
    private int currentPage = 1;
    private int pageSize = 15;
    private bool showModal = false;
    private Allocation selectedItem = new();
    private ReturnRequest returnRequest = new ReturnRequest();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            string fDate = fromDate.ToString("yyyy-MM-dd");
            string tDate = toDate.ToString("yyyy-MM-dd");
            allocations = await Http.GetFromJsonAsync<List<Allocation>>($"api/warehouse/allocations?from={fDate}&to={tDate}");
            currentPage = 1;
            UpdatePagedList();
        }
        catch (Exception ex) { Console.WriteLine($"Lỗi: {ex.Message}"); }
    }

    private async Task ShowAll()
    {
        fromDate = new DateTime(2020, 1, 1);
        toDate = DateTime.Now;
        await LoadData();
    }

    private void UpdatePagedList() { if (allocations != null) pagedAllocations = allocations.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList(); }
    private void ChangePage(int page) { currentPage = page; UpdatePagedList(); }
    private void OpenModal(Allocation item) { selectedItem = item; returnRequest = new ReturnRequest { Note = "", ReturnDate = DateTime.Now }; showModal = true; }
    private void CloseModal() => showModal = false;
    private async Task SubmitReturn() { if (string.IsNullOrWhiteSpace(returnRequest.Note)) { await JS.InvokeVoidAsync("alert", "Vui lòng nhập lý do!"); return; } var res = await Http.PostAsJsonAsync($"api/allocations/return/{selectedItem.AllocationID}", returnRequest); if (res.IsSuccessStatusCode) { await JS.InvokeVoidAsync("alert", "Thu hồi thành công!"); showModal = false; await LoadData(); } else { await JS.InvokeVoidAsync("alert", "Lỗi thu hồi!"); } }

    public class ReturnRequest { public string Note { get; set; } = ""; public DateTime ReturnDate { get; set; } = DateTime.Now; }
    public class Allocation { public int AllocationID { get; set; } public string AssetName { get; set; } public string Serial { get; set; } public string DepartmentName { get; set; } public string ReceiverName { get; set; } public DateTime AllocatedDate { get; set; } public int Status { get; set; } }
}