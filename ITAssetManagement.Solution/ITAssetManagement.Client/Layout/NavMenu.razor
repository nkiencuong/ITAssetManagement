<div class="top-row">
    <div class="brand-title d-flex align-items-center gap-2">
        <div class="brand-icon">
            <img src="images/logo_bv.png" class="custom-icon" alt="Logo" style="width: 42px; height: 42px; object-fit: contain;" />
        </div>
        <div class="d-flex flex-column justify-content-center text-start">
            <span style="font-size: 0.95rem; color: #0284c7; font-weight: 800; text-transform: uppercase; line-height: 1.2; margin-bottom: 2px;">
                BVĐK HẢI DƯƠNG
            </span>
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1;">
                Phòng CNTT
            </span>
        </div>
    </div>
</div>

<nav>
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="material-icons-outlined">dashboard</span> Trang Chủ
        </NavLink>
    </div>

    <AuthorizeView Roles="Admin, SuperAdmin">
        <div class="nav-item">
            <NavLink class="nav-link" href="assets">
                <span class="material-icons-outlined">computer</span> Quản lý Tài Sản
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="allocations">
                <span class="material-icons-outlined">cached</span> Cấp Phát
            </NavLink>
        </div>
    </AuthorizeView>

    @* 🚀 ĐÃ GẮN id="menu-sua-chua" VÀO ĐÂY *@
    <div class="nav-item">
        <NavLink class="nav-link" href="repairs" id="menu-sua-chua">
            <span class="material-icons-outlined">build</span> Sửa Chữa
        </NavLink>
    </div>

    <AuthorizeView Roles="Admin, SuperAdmin">
        <div class="nav-item">
            <NavLink class="nav-link" href="history">
                <span class="material-icons-outlined">history</span> Lịch Sử Kho
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="inventory">
                <span class="material-icons-outlined">inventory_2</span> Kiểm Kê
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="report">
                <span class="material-icons-outlined">assessment</span> Báo Cáo Xuất Kho
            </NavLink>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="SuperAdmin">
        <div class="nav-item">
            <NavLink class="nav-link" href="users">
                <span class="material-icons-outlined">manage_accounts</span> Quản lý Tài khoản
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="audit-logs">
                <span class="material-icons-outlined">receipt_long</span> Nhật ký Hệ thống
            </NavLink>
        </div>
    </AuthorizeView>
</nav>

<AuthorizeView>
    <Authorized>
        <div class="user-profile-bottom">
            <div class="avatar" style="display: flex; align-items: center; justify-content: center; color: white; background-color: #64748b;">
                <span class="material-icons-outlined" style="font-size: 20px;">person</span>
            </div>
            <div style="font-size: 0.85rem; line-height: 1.2;">
                <div style="font-weight: 600;">@context.User.Identity?.Name</div>
                <div style="color: var(--text-gray); font-size: 0.75rem;">
                    <span style="display: inline-block; width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; margin-right: 4px;"></span>
                    Đang trực tuyến
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() { collapseNavMenu = !collapseNavMenu; }
}